/* SPDX-License-Identifier: MIT
 * Copyright (c) 2026 Adrian Sutherland
 * Compile-only TSO31 consumer checks through a selected native cross compiler.
 * Run from the repository root. No linker, guest or SDK mutation is performed.
 */
options levelb
main: procedure = .int
  arg args = .string[]
  if args.0 <> 3 then do
    say "usage: crexx -nokeep tso31-bridge/scripts/check-target.crexx --args compiler gcc-prefix target-binutils-prefix"
    say "Both prefixes are directories with a trailing slash; target-binutils-prefix contains unprefixed as."
    return 2
  end
  compiler = args.1
  gcc_prefix = "-B" || args.2
  binutils_prefix = "-B" || args.3
  output = "build/tso31-target"
  address crexx "run :compiler --version"
  if rc <> 0 then return rc
  address crexx "run cmake -E make_directory :output"
  if rc <> 0 then return rc
  do i = 1 to 2
    name = "target_layout"
    if i = 2 then name = "caller"
    source = "tso31-bridge/tests/target_layout.c"
    if i = 2 then source = "tso31-bridge/src/caller.c"
    object = output || "/" || name || ".o"
    address crexx "run :compiler :binutils_prefix :gcc_prefix -std=c89 -pedantic-errors -Wall -Wextra -Werror -mexperimental-s370 -m31 -mesa -msoft-float -ffreestanding -fno-builtin -fno-pic -fno-pie -fno-asynchronous-unwind-tables -fno-unwind-tables -fno-stack-protector -O2 -c :source -o :object"
    if rc <> 0 then return rc
  end
  say "TSO31 layout assertions and caller compilation passed. Inspect the selected ELF producer/output separately; this is not link or execution qualification."
  return 0
