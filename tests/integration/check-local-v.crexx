/* SPDX-License-Identifier: MIT */
options levelb
main: procedure = .int
  arg args = .string[]
  if args.0 <> 4 then return 2
  cli = args.1; linker = args.2; checker = args.3; work = args.4
  if work = "" | work = "." | work = "/" then return 2
  address crexx "run cmake -E make_directory :work"
  if rc <> 0 then return rc
  deck = work || "/local-v.obj"; binary = work || "/local-v.bin"
  address crexx "run cmake -E rm -f :deck :binary"
  if rc <> 0 then return rc
  address crexx "run :cli assembler/tests/fixtures/local-v.asm :deck"
  if rc <> 0 then return rc
  address crexx "run :linker --oformat binary --image-base 4096 -e LOCAL -o :binary :deck"
  if rc <> 0 then return rc
  address crexx "run :checker local-v :binary"
  return rc
