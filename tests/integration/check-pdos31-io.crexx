/* SPDX-License-Identifier: MIT */
options levelb
import rxfnsb
main: procedure = .int
  arg args = .string[]
  if args.0 <> 4 then return 2
  cli = args.1; linker = args.2; checker = args.3; work = args.4
  if work = "" | work = "." | work = "/" then return 2
  address crexx "run cmake -E make_directory :work"
  if rc <> 0 then return rc
  do i = 1 to 15
    source = word("pdos31-io-templates pdos31-get pdos31-io-maps pdos31-io-services pdos31-directory pdos31-wto pdos31-diagnostics pdos31-trkcalc pdos31-basic-dcb pdos31-bsam pdos31-sync pdos31-freepool pdos31-task pdos31-runtime-maps classic-partial-save",i)
    entry = word("IOTEST GETTEST IOMAPS IOSVCS DIRTEST WTOTEST DIAGTEST TRKTEST BASICTST BSAMTEST SYNCTEST POOLTEST TASKTEST RTMAPS LINKTST",i)
    mode = word("pdos31-io pdos31-get pdos31-io-maps pdos31-io-services pdos31-directory pdos31-wto pdos31-diagnostics pdos31-trkcalc pdos31-basic-dcb pdos31-bsam pdos31-sync pdos31-freepool pdos31-task pdos31-runtime-maps classic-partial-save",i)
    deck = work || "/" || source || ".obj"
    binary = work || "/" || source || ".bin"
    source = "assembler/tests/fixtures/" || source || ".asm"
    address crexx "run cmake -E rm -f :deck :binary"
    if rc <> 0 then return rc
    address crexx "run :cli --profile s370 --macros -I pdpclib/src/interfaces/pdos31 -I pdpclib/src/interfaces/classic-linkage :source :deck"
    if rc <> 0 then return rc
    address crexx "run :linker --oformat binary --image-base 4096 -e :entry -o :binary :deck"
    if rc <> 0 then return rc
    address crexx "run :checker :mode :binary"
    if rc <> 0 then return rc
  end
  do i = 1 to 12
    source = "assembler/tests/fixtures/" || word("pdos31-io-unsupported pdos31-directory-unsupported pdos31-camlst-unsupported pdos31-wto-unsupported pdos31-snap-unsupported pdos31-trkcalc-unsupported pdos31-bsam-unsupported pdos31-sync-unsupported pdos31-freepool-unsupported pdos31-task-unsupported pdos31-runtime-maps-unsupported classic-partial-save-unsupported",i) || ".asm"
    failed = work || "/io-failed.obj"
    address crexx "run cmake -E rm -f :failed"
    if rc <> 0 then return rc
    address crexx "run :cli --profile s370 --macros -I pdpclib/src/interfaces/pdos31 -I pdpclib/src/interfaces/classic-linkage :source :failed"
    if rc = 0 then return 1
    address crexx "run :checker absent :failed"
    if rc <> 0 then return rc
  end
  return 0
