/* SPDX-License-Identifier: MIT
 * A disposable-runner typo/signing check for the nine Apple Actions secrets.
 * No product build, package installation, notarization submission or upload.
 */
options levelb
import rxfnsb

main: procedure = .int expose keychain secret_dir summary
  arg args = .string[]
  keychain = ""; secret_dir = ""; summary = getenv("GITHUB_STEP_SUMMARY")
  if args.0 = 1 then do
    if args.1 = "test" then return test_base64()
    if args.1 = "cleanup" then do
      call require getenv("GITHUB_ACTIONS") = "true" & getenv("RUNNER_TEMP") <> "", "cleanup requires the disposable runner"
      secret_dir = getenv("RUNNER_TEMP") || "/apple-signing-secrets-check"
      keychain = secret_dir || "/signing.keychain-db"
      return cleanup()
    end
  end
  call require args.0 = 0, "usage: check-apple-secrets.crexx [--args test|cleanup]"
  call require getenv("GITHUB_ACTIONS") = "true" & getenv("RUNNER_TEMP") <> "", "signing check requires the disposable GitHub runner"
  names = "APPLE_DEVELOPER_ID_CERTIFICATE_BASE64 APPLE_DEVELOPER_ID_CERTIFICATE_PASSWORD APPLE_DEVELOPER_ID_IDENTITY APPLE_DEVELOPER_ID_INSTALLER_CERTIFICATE_BASE64 APPLE_DEVELOPER_ID_INSTALLER_CERTIFICATE_PASSWORD APPLE_DEVELOPER_ID_INSTALLER_IDENTITY APPLE_ID APPLE_APP_SPECIFIC_PASSWORD APPLE_TEAM_ID"
  missing = ""
  i = .int
  name = .string
  do i = 1 to words(names)
    name = word(names,i)
    if strip(getenv(name)) = "" then missing = missing || " " || name
  end
  call require missing = "", "missing secret names:" || missing
  call pass "All nine secret names are present"
  do i = 1 to 2
    name = "APPLE_DEVELOPER_ID_CERTIFICATE_BASE64"
    if i = 2 then name = "APPLE_DEVELOPER_ID_INSTALLER_CERTIFICATE_BASE64"
    call require valid_base64(getenv(name)) = 1, name || ": invalid Base64 format; use a single line, no quotes or whitespace, and retain the final = or == padding"
    call pass name || ": Base64 format"
  end
  candidate = getenv("RUNNER_TEMP") || "/apple-signing-secrets-check"
  address crexx "run test -e :candidate"
  call require rc = 1, "fresh owned signing-check directory"
  secret_dir = candidate
  address crexx "run cmake -E make_directory :secret_dir"
  call require rc = 0, "create signing-check directory"
  address crexx "run chmod 700 :secret_dir"
  call require rc = 0, "private signing-check directory permissions"
  quiet = .string[]; random_lines = .string[]
  address crexx "run openssl rand -hex 32" output random_lines error quiet
  call require rc = 0 & random_lines.0 = 1, "generate temporary keychain password"
  password = strip(random_lines.1)
  keychain = secret_dir || "/signing.keychain-db"
  address crexx "run security create-keychain -p :password :keychain" output quiet error quiet
  call require rc = 0, "create private temporary keychain"
  address crexx "run security set-keychain-settings -lut 3600 :keychain" output quiet error quiet
  call require rc = 0, "set temporary keychain lifetime"
  address crexx "run security lock-keychain :keychain" output quiet error quiet
  call require rc = 0, "lock temporary keychain"
  address crexx "run security unlock-keychain -p :password :keychain" output quiet error quiet
  call require rc = 0, "unlock temporary keychain"
  call pass "Temporary keychain creates, locks and unlocks"
  do i = 1 to 2
    kind = ""
    if i = 2 then kind = "INSTALLER_"
    certificate_name = "APPLE_DEVELOPER_ID_" || kind || "CERTIFICATE_BASE64"
    password_name = "APPLE_DEVELOPER_ID_" || kind || "CERTIFICATE_PASSWORD"
    cert = secret_dir || "/certificate-" || i || ".p12"
    address shell "umask 077; printf '%s' " || '"$' || certificate_name || '"' || " | base64 -D > " || quote(cert) output quiet error quiet
    call require rc = 0, certificate_name || ": Base64 decoding failed"
    address shell "security import " || quote(cert) || " -k " || quote(keychain) || " -P " || '"$' || password_name || '"' || " -T /usr/bin/codesign -T /usr/bin/productbuild" output quiet error quiet
    call require rc = 0, certificate_name || " / " || password_name || ": PKCS12 import failed; check the p12 export includes its private key and the matching export password"
    address crexx "run cmake -E rm -f :cert"
    call require rc = 0, "remove exported certificate file"
    call pass certificate_name || " and " || password_name || ": PKCS12 import succeeded"
  end
  address crexx "run security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k :password :keychain" output quiet error quiet
  call require rc = 0, "allow noninteractive private-key access"
  root = secret_dir || "/root"
  directory = root || "/usr/local/lib/apple-signing-secrets-check"
  address crexx "run cmake -E make_directory :directory"
  call require rc = 0, "create synthetic probe payload"
  source = secret_dir || "/probe.c"
  call lineout source,"int main(void) { return 0; }"
  call lineout source
  probe = directory || "/probe"
  address crexx "run /usr/bin/clang -O2 :source -o :probe" output quiet error quiet
  call require rc = 0, "compile tiny synthetic Mach-O probe"
  identity = getenv("APPLE_DEVELOPER_ID_IDENTITY")
  identities = .string[]
  address crexx "run security find-identity -v -p codesigning :keychain" output identities error quiet
  call require rc = 0, "inspect imported code-signing identities"
  identity_count = 0; selector_matches = 0
  do i = 1 to identities.0
    fingerprint = word(identities[i],2)
    if length(fingerprint) = 40 & verify(translate(fingerprint),"0123456789ABCDEF") = 0 then do
      identity_count = identity_count + 1
      start_quote = pos('"',identities[i])
      common_name = ""
      if start_quote > 0 then common_name = substr(identities[i],start_quote + 1,length(identities[i]) - start_quote - 1)
      if translate(identity) = translate(fingerprint) | identity = common_name then selector_matches = selector_matches + 1
    end
  end
  say "Valid code-signing identities in temporary keychain: " || identity_count
  say "Exact Application selector matches (name or SHA-1): " || selector_matches
  signing_errors = .string[]
  address crexx "run codesign --force --timestamp --options runtime --keychain :keychain --sign :identity :probe" output quiet error signing_errors
  signing_rc = rc
  if signing_rc <> 0 then do
    say "Application codesign exit status: " || signing_rc
    do i = 1 to signing_errors.0
      call diagnostic signing_errors[i],password
    end
  end
  call require signing_rc = 0, "Application signing failed after PKCS12 import; see the codesign diagnostic above before changing certificate or identity secrets"
  address crexx "run codesign --verify --strict :probe" output quiet error quiet
  call require rc = 0, "verify Application probe signature"
  details = .string[]
  address crexx "run codesign --display --verbose=4 :probe" output details error details
  call require rc = 0, "read signed probe team identity"
  description = ""
  do i = 1 to details.0
    description = description || details[i] || '0A'x
  end
  call require pos("Authority=Developer ID Application:",description) > 0, "APPLE_DEVELOPER_ID_CERTIFICATE_BASE64: probe must use a Developer ID Application certificate"
  call require pos("TeamIdentifier=" || getenv("APPLE_TEAM_ID") || '0A'x,description) > 0, "APPLE_TEAM_ID: does not match the imported Application certificate team"
  call pass "APPLE_DEVELOPER_ID_IDENTITY: real Application signing and signature verification"
  call pass "APPLE_TEAM_ID: matches the signed Application certificate"
  component = secret_dir || "/component.pkg"
  address crexx "run pkgbuild --root :root --identifier org.crexx.apple-signing-secrets-check --version 0.0.1 --install-location / :component" output quiet error quiet
  call require rc = 0, "construct tiny synthetic component package"
  installer = secret_dir || "/signed-probe.pkg"
  identity = getenv("APPLE_DEVELOPER_ID_INSTALLER_IDENTITY")
  call arraydrop(signing_errors)
  address crexx "run productbuild --package :component --keychain :keychain --sign :identity --timestamp :installer" output quiet error signing_errors
  signing_rc = rc
  if signing_rc <> 0 then do
    say "Installer productbuild exit status: " || signing_rc
    do i = 1 to signing_errors.0
      call diagnostic signing_errors[i],password
    end
  end
  call require signing_rc = 0, "Installer signing failed after PKCS12 import; see the productbuild diagnostic above"
  call arraydrop(details)
  address crexx "run pkgutil --check-signature :installer" output details error details
  call require rc = 0, "verify Installer probe signature"
  description = ""
  do i = 1 to details.0
    description = description || details[i] || '0A'x
  end
  call require pos("Developer ID Installer:",description) > 0, "APPLE_DEVELOPER_ID_INSTALLER_CERTIFICATE_BASE64: package must use a Developer ID Installer certificate"
  call require pos("(" || getenv("APPLE_TEAM_ID") || ")",description) > 0, "APPLE_TEAM_ID: does not match the imported Installer certificate team"
  call pass "APPLE_DEVELOPER_ID_INSTALLER_IDENTITY: real Installer signing and signature verification"
  address shell "xcrun notarytool store-credentials apple-secrets-check --validate --keychain " || quote(keychain) || ' --apple-id "$APPLE_ID" --password "$APPLE_APP_SPECIFIC_PASSWORD" --team-id "$APPLE_TEAM_ID"' output quiet error quiet
  call require rc = 0, "APPLE_ID / APPLE_APP_SPECIFIC_PASSWORD / APPLE_TEAM_ID: Apple account validation failed; check account, app-specific password and team access, or retry if Apple is unavailable"
  call pass "APPLE_ID, APPLE_APP_SPECIFIC_PASSWORD and APPLE_TEAM_ID: Apple account validation"
  cleanup_result = cleanup()
  call require cleanup_result = 0, "remove private signing-check files"
  call pass "All nine secrets exercised; private files removed; no notarization submission"
  return 0

valid_base64: procedure = .int
  arg value = .string
  size = length(value); four = 4; remainder = 0
  assembler imod remainder,size,four
  if value = "" | remainder <> 0 then return 0
  if verify(value,"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=") <> 0 then return 0
  padding = pos("=",value)
  if padding = 0 then return 1
  if padding = 1 then return 0
  suffix = substr(value,padding)
  return suffix = "=" | suffix = "=="

test_base64: procedure = .int
  good = .string[]; bad = .string[]
  good.1 = "YQ=="; good.2 = "YWI="; good.3 = "YWJj"; good.4 = "YWJjZA=="
  bad.1 = ""; bad.2 = "YQ="; bad.3 = "YQ==="; bad.4 = "YQ==x"
  bad.5 = "YQ==" || '0A'x; bad.6 = "YQ== "; bad.7 = '"YQ=="'; bad.8 = "AA=A"
  i = .int
  do i = 1 to good.0
    if valid_base64(good[i]) <> 1 then return 1
  end
  do i = 1 to bad.0
    if valid_base64(bad[i]) <> 0 then return 1
  end
  say "PASS: Base64 padding, trailing data, whitespace and quoting controls"
  return 0

cleanup: procedure = .int expose keychain secret_dir
  discarded = .string[]
  if keychain <> "" then do
    address crexx "run test -e :keychain"
    if rc = 0 then do
      address crexx "run security delete-keychain :keychain" output discarded error discarded
      if rc <> 0 then do
        say "FAILED: delete private temporary keychain"
        return 1
      end
    end
    keychain = ""
  end
  if secret_dir <> "" then do
    address crexx "run cmake -E rm -rf :secret_dir"
    if rc <> 0 then return rc
    secret_dir = ""
  end
  return 0

pass: procedure = .int expose summary
  arg detail = .string
  say "PASS: " || detail
  if summary <> "" then do
    call lineout summary,"- PASS: " || detail
    call lineout summary
  end
  return 0

require: procedure = .int expose keychain secret_dir summary
  arg condition = .int, detail = .string
  if condition <> 1 then do
    say "FAILED: " || detail
    if summary <> "" then do
      call lineout summary,"- **FAILED:** " || detail
      call lineout summary
    end
    call cleanup
    exit 1
  end
  return 0

quote: procedure = .string
  arg value = .string
  return "'" || changestr("'",value,"'\''") || "'"

diagnostic: procedure = .int
  arg message = .string, temporary_password = .string
  names = "APPLE_DEVELOPER_ID_CERTIFICATE_BASE64 APPLE_DEVELOPER_ID_CERTIFICATE_PASSWORD APPLE_DEVELOPER_ID_IDENTITY APPLE_DEVELOPER_ID_INSTALLER_CERTIFICATE_BASE64 APPLE_DEVELOPER_ID_INSTALLER_CERTIFICATE_PASSWORD APPLE_DEVELOPER_ID_INSTALLER_IDENTITY APPLE_ID APPLE_APP_SPECIFIC_PASSWORD APPLE_TEAM_ID"
  i = .int
  do i = 1 to words(names)
    value = getenv(word(names,i))
    if value <> "" then message = changestr(value,message,"[redacted]")
  end
  if temporary_password <> "" then message = changestr(temporary_password,message,"[redacted]")
  say "Signing diagnostic: " || message
  return 0
