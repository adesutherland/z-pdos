              first && $1 == "L" && $2 ~ /^14,=A\(@@L[0-9]+\)$/ { t = $2; sub(/^14,=A\(/, "", t); sub(/\)$/, "", t); if (t in seen) want = 1 }
              want && !first && $1 == "BR" && $2 == "14" { f = 1 }
-             { if (!first) want = 0; first = ($0 ~ /^@@PG[0-9]+[ \t]+EQU/) }
+             { if (!first) want = 0; first = ($0 ~ /^@P[0-9]+[ \t]+EQU/) }
              END { exit !f }' "$WORK/pg.s" && pghit=$((pghit + 1))
