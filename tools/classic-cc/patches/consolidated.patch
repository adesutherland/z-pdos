 /* Convert function calls to rtl insns, for GNU C compiler.
    Copyright (C) 1989, 1992, 1993, 1994, 1995, 1996, 1997, 1998,
    1999, 2000, 2001, 2002, 2003, 2004 Free Software Foundation, Inc.
@@ -1371,6 +1372,35 @@ compute_argument_block_size (int reg_parm_stack_space,
    routine fills in the INITIAL_VALUE and VALUE fields for each
    precomputed argument.  */
 
+#ifdef PRECOMPUTE_NONTRIVIAL_CALL_ARGS
+/* On a target whose outgoing arguments live in a fixed area that library
+   calls use too (i370: every call passes its arguments at 88(13)), an
+   argument whose expansion emits a library call - a DImode multiply or
+   divide, or a conversion between DImode and DFmode - clobbers any argument
+   already stored.  calls_function cannot see such calls in the tree.  GCC
+   does save and restore the area around them, but the restore lies inside
+   the libcall block, which CSE treats as free of side effects: at -O1 and
+   above it rewrote the restore into a copy of the slot onto itself and
+   deleted the save, so the earlier argument was lost - pow (10.0, (double) e)
+   was called with e's bits as its base.  Evaluating every non-trivial
+   argument before storing any avoids the conflict altogether.  */
+static int
+precompute_nontrivial_arg_p (tree arg)
+{
+  tree type = TREE_TYPE (arg);
+  if (TREE_ADDRESSABLE (type) || TYPE_MODE (type) == BLKmode)
+    return 0;
+  switch (TREE_CODE (arg))
+    {
+    case INTEGER_CST: case REAL_CST: case STRING_CST:
+    case VAR_DECL: case PARM_DECL: case ADDR_EXPR:
+      return 0;
+    default:
+      return !TREE_CONSTANT (arg);
+    }
+}
+#endif
+
 static void
 precompute_arguments (int flags, int num_actuals, struct arg_data *args)
 {
@@ -1393,7 +1423,11 @@ precompute_arguments (int flags, int num_actuals, struct arg_data *args)
 
   for (i = 0; i < num_actuals; i++)
     if ((flags & ECF_LIBCALL_BLOCK)
-	|| calls_function (args[i].tree_value, !ACCUMULATE_OUTGOING_ARGS))
+	|| calls_function (args[i].tree_value, !ACCUMULATE_OUTGOING_ARGS)
+#ifdef PRECOMPUTE_NONTRIVIAL_CALL_ARGS
+	|| (optimize && precompute_nontrivial_arg_p (args[i].tree_value))
+#endif
+	)
       {
 	enum machine_mode mode;
 
