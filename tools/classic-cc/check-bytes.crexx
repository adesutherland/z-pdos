/* SPDX-License-Identifier: MIT; compiler/assembler numeric-byte boundary. */
options levelb
import rxfnsb
main: procedure = .int
  arg args = .string[]
  if args.0 <> 4 then return 2
  variant = args.1; cli = args.2; linker = args.3; checker = args.4
  if variant <> "mvs" & variant <> "cms" then return 2
  compiler = "build/classic-cc/" || variant || "/gcc/mf-classic-cc"
  work = "build/classic-cc/" || variant || "/byte-checks"
  address crexx "run cmake -E make_directory :work"
  if rc <> 0 then return rc
  do i = 1 to 4
    mode = word("-O0 -O1 -O2 -Os",i)
    source = work || "/" || mode || ".asm"
    deck = work || "/" || mode || ".obj"
    binary = work || "/" || mode || ".bin"
    address crexx "run cmake -E rm -f :deck :binary"
    if rc <> 0 then return rc
    address crexx "run :compiler -S :mode tools/classic-cc/tests/encoded-bytes.c -o :source"
    if rc <> 0 then return rc
    address crexx "run :cli --macros -I pdpclib/profiles/mvs38-s370-24 -I pdpclib :source :deck"
    if rc <> 0 then return rc
    address crexx "run :linker --oformat binary -e ALLBYTES -o :binary :deck"
    if rc <> 0 then return rc
    address crexx "run :checker encoded-bytes :binary"
    if rc <> 0 then return rc
    say variant mode "all 256 numeric byte values pass independent assembly/link checking"
  end
  return 0
