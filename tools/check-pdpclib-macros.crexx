/* SPDX-License-Identifier: MIT
 * Copyright (c) 2026 Adrian Sutherland
 * Gate 1 consumer of the maintained PDPCLIB source, not a source rewrite.
 * The supplied file's public-domain notice and contributor header are retained
 * in the test-owned subset. No IBM macro library or expansion is consumed.
 */
options levelb
import rxfnsb

main: procedure = .int
  arg args = .string[]
  if args.0 <> 4 then do
    say "usage: crexx tools/check-pdpclib-macros.crexx --args assembler checker mvssupa.asm owned-build-directory"
    return 2
  end
  cli = args.1; checker = args.2; original = args.3; work = args.4
  call require work <> "" & work <> "/" & work <> ".", "owned build directory"
  address system "cmake -E make_directory " || shellquote(work)
  call require rc = 0, "create build directory"
  hashfile = work || "/source.sha256"
  address system "shasum -a 256 " || shellquote(original) || " > " || shellquote(hashfile)
  call require rc = 0, "hash supplied source"
  hash = word(readfile(hashfile), 1)
  call require hash = "5c8fdd3f7bacf71eb4689c96f8ecdb58bb0e5a0ecef66a395df1d65e6b1b972c", "reviewed maintained source identity"
  source = readfile(original)
  subset = extract_lines(source, 2, 59) || extract_lines(source, 298, 302) || extract_lines(source, 306, 309) || extract_lines(source, 455, 459)
  subset = subset || "MACREF   CSECT" || '0A'x || "R14      EQU   14" || '0A'x
  subset = subset || "FIRST    LDVAL 4,16(1)" || '0A'x || "         LDADD 5,20(1)" || '0A'x
  subset = subset || "         STVAL 6,24(1)" || '0A'x || "         STVAL 6,28(1),S=7" || '0A'x
  subset = subset || "         END FIRST" || '0A'x
  input = work || "/source-owned-macros.asm"; output = work || "/source-owned-macros.obj"
  call writefile input, subset
  address system "cmake -E rm -f " || shellquote(output)
  call require rc = 0, "clear test-owned output"
  address crexx "run :cli --macros :input :output"
  call require rc = 0, "assemble unchanged source-owned definitions"
  address crexx "run :checker :output"
  call require rc = 0, "independent instruction and deck meaning"
  address system "shasum -a 256 " || shellquote(input) || " " || shellquote(output)
  call require rc = 0, "consumer identities"
  say "Only these three source-owned macro definitions are qualified; whole MVSSUPA assembly and services remain open."
  return 0

shellquote: procedure = .string
  arg value = .string
  return "'" || changestr("'", value, "'\''") || "'"

require: procedure = .int
  arg condition = .int, detail = .string
  if condition <> 1 then do
    say "FAILED: " || detail
    exit 1
  end
  return 0

extract_lines: procedure = .string
  arg text = .string, first = .int, last = .int
  at = 1; result = ""
  do line = 1 to last
    endline = pos('0A'x, text, at)
    call require endline >= at, "complete reference source line"
    if line >= first then result = result || substr(text, at, endline - at + 1)
    at = endline + 1
  end
  return result

readfile: procedure = .string
  arg path = .string
  file_id = 0; mode = "rb"
  assembler fopen file_id,path,mode
  call require file_id <> 0, "open reference input"
  result = ""; eof = 0; read_status = 0
  do forever
    data = ""
    assembler freadline data,file_id
    read_status = 0
    assembler ferror read_status,file_id
    call require read_status = 0, "reference read without I/O failure"
    assembler feof eof,file_id
    if length(data) = 0 & eof <> 0 then leave
    result = result || data || '0A'x
    call require length(result) <= 1048576, "reference input size limit"
  end
  read_status = 0; close_status = 0
  assembler ferror read_status,file_id
  assembler fclose close_status,file_id
  call require read_status = 0 & close_status = 0, "complete reference read"
  return result

writefile: procedure = .int
  arg path = .string, text = .string
  file_id = 0; mode = "wb"; data = text as .binary
  assembler fopen file_id,path,mode
  call require file_id <> 0, "open owned output"
  assembler fwriteb file_id,data
  write_status = 0; close_status = 0
  assembler ferror write_status,file_id
  assembler fclose close_status,file_id
  call require write_status = 0 & close_status = 0, "complete owned write"
  return 0
