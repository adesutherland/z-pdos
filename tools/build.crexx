options levelb
main: procedure = .int
  arg args = .string[]
  action = "test"
  if args.0 > 1 then do
    say "usage: crexx tools/build.crexx --args build|test|sanitize"
    return 2
  end
  if args.0 = 1 then action = args.1
  if action <> "build" & action <> "test" & action <> "sanitize" then do
    say "usage: crexx tools/build.crexx --args build|test|sanitize"
    return 2
  end
  build_dir = "build/classic-as"
  sanitize = "OFF"
  if action = "sanitize" then do
    build_dir = "build/classic-as-sanitize"
    sanitize = "ON"
  end
  address crexx "run cmake -S . -B :build_dir -DMF_SANITIZERS=:sanitize"
  if rc <> 0 then return rc
  address crexx "run cmake --build :build_dir"
  if rc <> 0 then return rc
  if action = "build" then return 0
  address crexx "run ctest --test-dir :build_dir --output-on-failure"
  return rc
