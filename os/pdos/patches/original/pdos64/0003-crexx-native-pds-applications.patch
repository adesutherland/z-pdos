+/* Read the real IBM PDS directory imported by dasdload. The supported
+   private-disk profile is one contiguous extent; aliases and arbitrary
+   member names use the directory's own TTR, never a name mapping. */
+static int pdos64PdsMember(PDOS *pdos, const char *dsn,
+                           const char member[8], unsigned char ttr[3],
+                           int *cyl, int *head, int *rec)
+{
+    DSCB1 dscb;
+    unsigned char block[256];
+    int basecyl, basehead, tt, rr, at, used, size;
+
+    if (!pdos64ReadDscb(pdos, dsn, &dscb)
+        || dscb.ds1dsorg != 0x0200 || dscb.ds1noepv != 1)
+        return -1;
+    basecyl = ((unsigned char)dscb.startcchh[0] << 8)
+              | (unsigned char)dscb.startcchh[1];
+    basehead = ((unsigned char)dscb.startcchh[2] << 8)
+               | (unsigned char)dscb.startcchh[3];
+    for (tt = 0; tt < 128; tt++)
+    {
+        int dcyl = basecyl + (basehead + tt) / 15;
+        int dhead = (basehead + tt) % 15;
+        for (rr = 1; rr < 100; rr++)
+        {
+            /* PDS directory records have an eight-byte CKD key. MVS
+               BSAM presents only the 256-byte data field to the caller. */
+            size = rdblock(pdos->ipldev, dcyl, dhead, rr,
+                           block, sizeof block, 0x06);
+            if (size < 0) break;
+            if (size != sizeof block) return -1;
+            used = block[0] * 256 + block[1];
+            if (used < 2 || used > 256) return -1;
+            at = 2;
+            while (at < used)
+            {
+                if (used - at < 8) return -1;
+                if (memcmp(block + at, "\xff\xff\xff\xff\xff\xff\xff\xff", 8) == 0)
+                    return 0;
+                if (used - at < 12) return -1;
+                if (memcmp(block + at, member, 8) == 0)
+                {
+                    int track;
+                    memcpy(ttr, block + at + 8, 3);
+                    track = ttr[0] * 256 + ttr[1];
+                    if (track >= 128 || ttr[2] == 0) return -1;
+                    *cyl = basecyl + (basehead + track) / 15;
+                    *head = (basehead + track) % 15;
+                    *rec = ttr[2];
+                    return 1;
+                }
+                at += 12 + 2 * (block[at + 11] & 31);
+                if (at > used) return -1;
+            }
+        }
+    }
+    return -1;
+}
+
+/* The retained PDPCLIB @@AOPEN DCB area puts ZMEM 0x90 bytes after its
+   OPEN TYPE=J list. Keep this small bridge specific to that service
+   object and refuse other output forms. The on-disk directory, VTOC and
+   extent remain the authority for every data set and member name. */
+#define PDOS64_PDS_WRITES 8
+typedef struct {
+    DCB *dcb;
+    RB *owner;
+    char dsn[45];
+    unsigned char member[8];
+    DSCB1 dscb;
+    int basecyl, basehead, endcyl, endhead;
+    int dircyl, dirhead, dirrec, diroff, replace;
+    unsigned char dirblock[256];
+    unsigned char first_ttr[3];
+    int records, failed;
+} PDOS64PDSWRITE;
+static PDOS64PDSWRITE pdos64_pds_writes[PDOS64_PDS_WRITES];
+
+static PDOS64PDSWRITE *pdos64PdsWriteState(DCB *dcb)
+{
+    int i;
+    for (i = 0; i < PDOS64_PDS_WRITES; i++)
+        if (pdos64_pds_writes[i].dcb == dcb)
+            return &pdos64_pds_writes[i];
+    return NULL;
+}
+
+static int pdos64PdsDirSlot(PDOS *pdos, PDOS64PDSWRITE *state)
+{
+    unsigned char raw[256];
+    int tt, rr, size, used, at, insertion;
+    for (tt = 0; tt < 128; tt++)
+    {
+        int cyl = state->basecyl + (state->basehead + tt) / 15;
+        int head = (state->basehead + tt) % 15;
+        if (cyl > state->endcyl
+            || (cyl == state->endcyl && head > state->endhead)) break;
+        for (rr = 1; rr < 100; rr++)
+        {
+            size = rdblock(pdos->ipldev, cyl, head, rr,
+                           raw, sizeof raw, 0x06);
+            if (size < 0) break;
+            if (size != sizeof raw)
+            {
+                printf("P64 PDS DIR BAD cyl=%d head=%d rec=%d size=%d\n",
+                       cyl, head, rr, size);
+                return 0;
+            }
+            used = raw[0] * 256 + raw[1];
+            if (used < 14 || used > 256) return 0;
+            at = 2;
+            insertion = -1;
+            while (at < used)
+            {
+                unsigned char *entry = raw + at;
+                if (used - at < 8) return 0;
+                if (memcmp(entry, "\xff\xff\xff\xff\xff\xff\xff\xff", 8) == 0)
+                {
+                    /* Keep the FF terminator and all variable-length entries.
+                       A new member precedes the first greater EBCDIC name. */
+                    if (at + 12 != used || used + 12 > 256) return 0;
+                    state->dircyl = cyl;
+                    state->dirhead = head;
+                    state->dirrec = rr;
+                    state->diroff = insertion < 0 ? at : insertion;
+                    state->replace = 0;
+                    memcpy(state->dirblock, raw, 256);
+                    return 1;
+                }
+                if (used - at < 12) return 0;
+                if (memcmp(entry, state->member, 8) == 0)
+                {
+                    if (entry[11] & 0x80) return 0; /* alias */
+                    state->dircyl = cyl;
+                    state->dirhead = head;
+                    state->dirrec = rr;
+                    state->diroff = at;
+                    state->replace = 1;
+                    memcpy(state->dirblock, raw, 256);
+                    return 1;
+                }
+                if (insertion < 0
+                    && memcmp(state->member, entry, 8) < 0)
+                    insertion = at;
+                at += 12 + 2 * (entry[11] & 31);
+                if (at > used) return 0;
+            }
+            /* A later directory block needs cross-block insertion/rebalance.
+               Refuse it rather than publish a name out of global order. */
+            return 0;
+        }
+    }
+    return 0;
+}
+
+static int pdos64PdsOpenWrite(PDOS *pdos, DCB *dcb,
+                              const char *dsn, const unsigned char member[8])
+{
+    PDOS64PDSWRITE *state = NULL;
+    int i, track, maxtrack, cyl, head, rec;
+    for (i = 0; i < PDOS64_PDS_WRITES; i++)
+        if (pdos64_pds_writes[i].dcb != NULL
+            && strcmp(pdos64_pds_writes[i].dsn, dsn) == 0)
+        {
+            printf("P64 PDS OPEN OVERLAP %s\n", dsn);
+            return 0;
+        }
+    for (i = 0; i < PDOS64_PDS_WRITES; i++)
+        if (pdos64_pds_writes[i].dcb == NULL)
+        { state = &pdos64_pds_writes[i]; break; }
+    if (state == NULL || strlen(dsn) > 44) return 0;
+    memset(state, 0, sizeof *state);
+    if (!pdos64ReadDscb(pdos, dsn, &state->dscb)
+        || state->dscb.ds1dsorg != 0x0200
+        || state->dscb.ds1noepv != 1)
+    {
+        printf("P64 PDS DSCB BAD %s org=%04x ext=%d\n", dsn,
+               (unsigned short)state->dscb.ds1dsorg,
+               state->dscb.ds1noepv);
+        return 0;
+    }
+    state->basecyl = ((unsigned char)state->dscb.startcchh[0] << 8)
+                     | (unsigned char)state->dscb.startcchh[1];
+    state->basehead = ((unsigned char)state->dscb.startcchh[2] << 8)
+                      | (unsigned char)state->dscb.startcchh[3];
+    state->endcyl = ((unsigned char)state->dscb.endcchh[0] << 8)
+                    | (unsigned char)state->dscb.endcchh[1];
+    state->endhead = ((unsigned char)state->dscb.endcchh[2] << 8)
+                     | (unsigned char)state->dscb.endcchh[3];
+    maxtrack = (state->endcyl - state->basecyl) * 15
+               + state->endhead - state->basehead;
+    track = ((unsigned char)state->dscb.ds1lstar[0] << 8)
+            | (unsigned char)state->dscb.ds1lstar[1];
+    rec = (unsigned char)state->dscb.ds1lstar[2];
+    if (state->basehead >= 15 || state->endhead >= 15
+        || track > maxtrack || rec == 0 || maxtrack >= 65536)
+    {
+        printf("P64 PDS LSTAR BAD %s track=%d rec=%d max=%d\n",
+               dsn, track, rec, maxtrack);
+        return 0;
+    }
+    strcpy(state->dsn, dsn);
+    memcpy(state->member, member, 8);
+    if (!pdos64PdsDirSlot(pdos, state))
+    {
+        printf("P64 PDS DIR SLOT BAD %s member=%.8s\n", dsn, member);
+        return 0;
+    }
+    cyl = state->basecyl + (state->basehead + track) / 15;
+    head = (state->basehead + track) % 15;
+    join_cchhr(dcb->dcbfdad + 3, cyl, head, rec);
+    state->dcb = dcb;
+    state->owner = pdos->context;
+    printf("P64 PDS OPEN %.8s %s lstar=%04x%02x %s\n",
+           member, dsn, track, rec, state->replace ? "replace" : "create");
+    return 1;
+}
+
+static int pdos64PdsRecord(PDOS *pdos, PDOS64PDSWRITE *state,
+                            DCB *dcb, const void *data, int len)
+{
+    unsigned char tbuf[MAXBLKSZ + 8];
+    int cyl, head, rec, count, track;
+    if (len < 0 || len > MAXBLKSZ || state->failed) return 0;
+    split_cchhr(dcb->dcbfdad + 3, &cyl, &head, &rec);
+    for (;;)
+    {
+        rec++;
+        track = (cyl - state->basecyl) * 15 + head - state->basehead;
+        if (track < 0 || cyl > state->endcyl
+            || (cyl == state->endcyl && head > state->endhead))
+            return 0;
+        *(short *)tbuf = cyl;
+        *(short *)(tbuf + 2) = head;
+        tbuf[4] = rec;
+        tbuf[5] = 0;
+        *(short *)(tbuf + 6) = len;
+        if (len) memcpy(tbuf + 8, data, len);
+        count = wrblock(pdos->ipldev, cyl, head, rec - 1,
+                        tbuf, len + 8, 0x1d);
+        if (count > 0) break;
+        rec = 0;
+        head++;
+        if (head == 15) { head = 0; cyl++; }
+    }
+    if (state->records == 0)
+    {
+        state->first_ttr[0] = track >> 8;
+        state->first_ttr[1] = track;
+        state->first_ttr[2] = rec;
+    }
+    state->records++;
+    join_cchhr(dcb->dcbfdad + 3, cyl, head, rec);
+    return 1;
+}
+
+static int pdos64PdsCloseWrite(PDOS *pdos, PDOS64PDSWRITE *state, DCB *dcb)
+{
+    DSCB1 dscb;
+    unsigned char block[256];
+    int vcyl, vhead, vrec, cyl, head, rec, track, used, at;
+    if (state->failed || !pdos64PdsRecord(pdos, state, dcb, NULL, 0))
+        return 0;
+    if (!pdos64ReadDscbLoc(pdos, state->dsn, &dscb,
+                            &vcyl, &vhead, &vrec)) return 0;
+    split_cchhr(dcb->dcbfdad + 3, &cyl, &head, &rec);
+    track = (cyl - state->basecyl) * 15 + head - state->basehead;
+    dscb.ds1lstar[0] = track >> 8;
+    dscb.ds1lstar[1] = track;
+    dscb.ds1lstar[2] = rec;
+    if (wrblock(pdos->ipldev, vcyl, vhead, vrec,
+                ((char *)&dscb) + 44, sizeof dscb - 44, 0x05)
+        != sizeof dscb - 44) return 0;
+    memcpy(block, state->dirblock, sizeof block);
+    at = state->diroff;
+    if (!state->replace)
+    {
+        used = block[0] * 256 + block[1];
+        /* Shift complete entries, including their user data and FF end. */
+        memmove(block + at + 12, block + at, used - at);
+        used += 12;
+        block[0] = used >> 8;
+        block[1] = used;
+        memcpy(block + at, state->member, 8);
+        block[at + 11] = 0;
+    }
+    memcpy(block + at + 8, state->first_ttr, 3);
+    if (wrblock(pdos->ipldev, state->dircyl, state->dirhead,
+                state->dirrec, block, sizeof block, 0x05)
+        != sizeof block) return 0;
+    printf("P64 PDS CLOSE %.8s %s ttr=%02x%02x%02x eof=%04x%02x\n",
+           state->member, state->dsn, state->first_ttr[0],
+           state->first_ttr[1], state->first_ttr[2], track, rec);
+    return 1;
+}
