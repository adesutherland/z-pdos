+#ifndef ZAM31
+/* This is the reached LOAD/DELETE subset for the low RMODE ANY launcher.
+   PDOS command loading already names private sequential load data sets as
+   <entry>.EXE. z/OS LOAD searches installed PDS libraries instead. The
+   bytes inside the data set are the same classic IEBCOPY unload member. */
+typedef struct {
+    RB *owner;
+    char name[8];
+    int slot;
+    int image_len;
+} PDOS64HIGHLOAD;
+static PDOS64HIGHLOAD pdos64_high_load;
+static int pdos64_high_next_slot;
+
+static int pdos64HighName(PDOS *pdos, char name[8], char dsn[13])
+{
+    /* This bounded macro path is issued after SAM31. The interrupted PSW
+       must actually say AMODE31; do not reinterpret a genuine AMODE64
+       address or a returned tagged LOAD entry as a low native pointer.
+       A 31-bit LA can leave GPR0's upper half from high C execution. */
+    unsigned int addr = (unsigned int)pdos->context->regs[0] & 0x7fffffffU;
+    const char *src;
+    int i, used = 0, blank = 0;
+    if ((pdos->context->psw64[0] & 1U) != 0
+        || (pdos->context->psw64[1] & 0x80000000U) == 0
+        || addr < 4096 || addr > MAXASIZE * 1024U * 1024 - 8)
+        return 0;
+    src = (const char *)addr;
+    memcpy(name, src, 8);
+    for (i = 0; i < 8; i++)
+    {
+        if (name[i] == ' ') { blank = 1; continue; }
+        if (blank || strchr(i == 0
+                            ? "ABCDEFGHIJKLMNOPQRSTUVWXYZ@$#"
+                            : "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@$#",
+                            (unsigned char)name[i]) == NULL)
+            return 0;
+        used++;
+    }
+    if (!used) return 0;
+    memcpy(dsn, name, used);
+    memcpy(dsn + used, ".EXE", 5);
+    return 1;
+}
+
+static int pdos64HighRead(PDOS *pdos, const char *dsn,
+                          char *raw, int capacity, int *length)
+{
+    DSCB1 dscb;
+    char block[MAXBLKSZ];
+    int cyl, head, rec = 1, endcyl, endhead, count, total = 0;
+    int tracks = 0;
+    if (!pdos64ReadDscb(pdos, dsn, &dscb)) return 0;
+    cyl = ((unsigned char)dscb.startcchh[0] << 8)
+        | (unsigned char)dscb.startcchh[1];
+    head = ((unsigned char)dscb.startcchh[2] << 8)
+        | (unsigned char)dscb.startcchh[3];
+    endcyl = ((unsigned char)dscb.endcchh[0] << 8)
+        | (unsigned char)dscb.endcchh[1];
+    endhead = ((unsigned char)dscb.endcchh[2] << 8)
+        | (unsigned char)dscb.endcchh[3];
+    if (head >= 15 || endhead >= 15 || cyl > endcyl
+        || (cyl == endcyl && head > endhead)) return 0;
+    while (tracks < 256 && (cyl < endcyl
+                            || (cyl == endcyl && head <= endhead)))
+    {
+        count = rdblock(pdos->ipldev, cyl, head, rec,
+                        block, sizeof block, 0x0e);
+        if (count == 0)
+        {
+            *length = total;
+            return total > 0;
+        }
+        if (count < 0)
+        {
+            head++;
+            if (head == 15) { head = 0; cyl++; }
+            rec = 1;
+            tracks++;
+            continue;
+        }
+        if (count > capacity - total) return 0;
+        memcpy(raw + total, block, count);
+        total += count;
+        rec++;
+    }
+    return 0; /* missing EOF or outside the declared first extent */
+}
+
+static void pdos64HighService(PDOS *pdos, int svc)
+{
+    enum { RAW_CAPACITY = 5 * 1024 * 1024 };
+    char name[8], dsn[13];
+    char *raw;
+    unsigned int base, physical;
+    int length, entry, slot;
+    RB *owner = pdos->context;
+    owner->regs[15] = 8;
+    if (__ismem || (svc == 8
+                    && ((unsigned int)owner->regs[1] & 0x7fffffffU))
+        || !pdos64HighName(pdos, name, dsn)) return;
+    if (svc == 9)
+    {
+        if (pdos64_high_load.owner != owner
+            || memcmp(name, pdos64_high_load.name, 8) != 0)
+        {
+            owner->regs[15] = 4;
+            return;
+        }
+        physical = PDOS64_CODE_PHYS
+            + pdos64_high_load.slot * PDOS64_CODE_SLOT_MB * 1024U * 1024;
+        memset((char *)physical, 0, pdos64_high_load.image_len);
+        printf("P64 DELETE %.8s slot=%d bytes=%d\n", name,
+               pdos64_high_load.slot, pdos64_high_load.image_len);
+        memset(&pdos64_high_load, 0, sizeof pdos64_high_load);
+        owner->regs[15] = 0;
+        return;
+    }
+    if (pdos64_high_load.owner != NULL) return;
+    raw = memmgrAllocate(&pdos->aspaces[pdos->curr_aspace].o.atlmem,
+                         RAW_CAPACITY, 0);
+    if (raw == NULL) return;
+    slot = pdos64_high_next_slot;
+    base = (PDOS64_CODE_VSEG + slot * PDOS64_CODE_SLOT_MB) << 20;
+    physical = PDOS64_CODE_PHYS + slot * PDOS64_CODE_SLOT_MB * 1024U * 1024;
+    if (!pdos64HighRead(pdos, dsn, raw, RAW_CAPACITY, &length)
+        || fixPEHigh(raw, &length, &entry, base, RAW_CAPACITY) != 0
+        || length > PDOS64_CODE_SLOT_MB * 1024 * 1024)
+    {
+        memmgrFree(&pdos->aspaces[pdos->curr_aspace].o.atlmem, raw);
+        printf("P64 LOAD reject %.8s\n", name);
+        return;
+    }
+    memset((char *)physical, 0, PDOS64_CODE_SLOT_MB * 1024 * 1024);
+    memcpy((char *)physical, raw, length);
+    memmgrFree(&pdos->aspaces[pdos->curr_aspace].o.atlmem, raw);
+    pdos64_high_load.owner = owner;
+    memcpy(pdos64_high_load.name, name, 8);
+    pdos64_high_load.slot = slot;
+    pdos64_high_load.image_len = length;
+    pdos64_high_next_slot = 1 - slot;
+    /* LOAD's GPR0 is a full-width entry with bit 63 (the low bit) set
+       for AMODE64. Module-relative offsets become an address only here. */
+    owner->regs64[0] = 1;
+    owner->regs[0] = (int)((base + (unsigned int)entry) | 1U);
+    owner->regs[1] = (length + 7) / 8;
+    owner->regs64[2] = 0;
+    owner->regs[15] = 0;
+    printf("P64 LOAD %.8s v=1%08x p=%08x e=1%08x n=%d\n",
+           name, base, physical, base + (unsigned int)entry, length);
+}
