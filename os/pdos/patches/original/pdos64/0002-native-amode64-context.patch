+        if (memcmp(tiot->ddentry[i] + 4, ddname, 8) == 0)
+        {
+            if (memcmp(ddname, "BTXT    ", 8) == 0)
+                return "B3BTXT.DAT";
+            if (memcmp(ddname, "BBIN    ", 8) == 0)
+                return "B3BBIN.DAT";
+        }
+    }
+    return NULL;
+}
