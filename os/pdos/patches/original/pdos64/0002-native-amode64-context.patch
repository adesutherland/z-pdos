+    memset(aste, 0, 64);
+    {
+        int i;
+        for (i = 0; i < 32; i++) link[i] = 0x80000000U;
+    }
+    memset(entry, 0, 16 * 32);
+    memset(pdos64_sft, 0, sizeof pdos64_sft);
+    memset(stack, 0, 4096);
+    /* ESAME primary ASTE word 6: one linkage-table entry. */
+    aste[6] = 0x80000000U | (unsigned int)link;
+    /* LX 0, EX 14. ETL is in groups of four entries. */
+    link[0] = (unsigned int)entry | 3U;
+    entry[14 * 8 + 1] = 0x80000000U | (unsigned int)p64pc;
+    entry[14 * 8 + 2] = 0xffff0000U; /* caller PKM authorization */
+    entry[14 * 8 + 4] = 0x80000000U; /* stacking PC to AMODE31 */
+    pdos64_sft[208 / 4] = 0; /* native macro ORs EX 14 */
+    pdos->psa->cvt->system_table = (int)pdos64_sft;
+    /* ESAME linkage-stack header descriptor, 4000 free bytes. */
+    stack[8] = 0x09;
+    stack[10] = 0x0f;
+    stack[11] = 0xa0;
+    lcreg3(0xffff0000U);
+    lcreg5((unsigned int)aste);
+    lcreg15((unsigned int)(stack + 8));
+}
