+/* Bind only the two preallocated DDs exercised by the frozen beta3 member.
+   The offsets are from IEFTIOT1 and IEFJFCBN in the retained MVUZ1 native
+   listing. Missing disk data sets produce no TIOT entry. */
+static int pdos64BindSmokeDd(PDOS *pdos, TIOT *tiot, int slot,
+                             const char *ddname, const char *dsn)
+{
+    unsigned char *entry;
+    unsigned char *jfcb;
+    unsigned int queue;
+    int cyl, head, rec;
+    int len;
+
+    if (findFile(pdos->ipldev, (char *)dsn, &cyl, &head, &rec) != 0)
+        return 0;
+    entry = tiot->ddentry[slot];
+    queue = (unsigned int)tiot->jfcb[slot];
+    if ((queue & 1U) || (queue >= 0x1000000U))
+        return -1;
+    entry[0] = 20; /* TIOELNGH */
+    memcpy(entry + 4, ddname, 8); /* TIOEDDNM */
+    entry[12] = (unsigned char)(queue >> 16);
+    entry[13] = (unsigned char)(queue >> 8);
+    entry[14] = (unsigned char)queue; /* TIOEJFCB */
+    jfcb = tiot->jfcb[slot] + 16;
+    memset(jfcb, 0, 0xb0);
+    memset(jfcb, ' ', 44);
+    len = strlen(dsn);
+    if (len > 44) return -1;
+    memcpy(jfcb, dsn, len); /* JFCBDSNM */
+    jfcb[0x62] = 0x40; /* JFCDSORG: PS */
+    jfcb[0x64] = 0x50; /* JFCRECFM: VB */
+    jfcb[0x66] = 800 >> 8;
+    jfcb[0x67] = 800 & 0xff; /* JFCBUFSI */
+    jfcb[0x68] = 0;
+    jfcb[0x69] = 80; /* JFCLRECL */
+    return 1;
+}
