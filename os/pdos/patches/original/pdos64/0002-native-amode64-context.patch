+        (((unsigned int)pdos64_aste_space + 63U) & ~63U);
+    unsigned int *link = (unsigned int *)
+        (((unsigned int)pdos64_link_space + 127U) & ~127U);
+    unsigned int *entry = (unsigned int *)
+        (((unsigned int)pdos64_entry_space + 511U) & ~511U);
+    unsigned char *stack = (unsigned char *)
+        (((unsigned int)pdos64_stack_space + 7U) & ~7U);
