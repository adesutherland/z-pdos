options levelb
import rxfnsb
main: procedure = .int
  arg args = .string[]
  i = .int; output = .string; file = .string
  if args.0 < 1 | args.0 > 2 then return usage()
  action = args.1
  if action <> "check" & action <> "compile" then return usage()
  work = "build/pdos/pdio1"
  if args.0 = 2 then work = args.2
  call require left(work,11) = "build/pdos/" & length(work) > 11 & pos("..",work) = 0, "owned build/pdos output"
  locations = .string[]
  address crexx "pwd" output locations
  root = strip(locations.1)
  out = root || "/" || work
  source = out || "/source"
  temporary = out || "/tmp"
  runtime = source || "/pdpclib"
  address crexx "run cmake -E make_directory :out :temporary"
  call require rc = 0, "create output"
  address system "shasum -a 256 -c os/pdos/source.sha256 > " || shellquote(out || "/source-check.log")
  call require rc = 0, "all maintained source hashes"
  patchdir = root || "/os/pdos/patches"
  address crexx "cd :patchdir"
  address system "shasum -a 256 -c original.sha256 > " || shellquote(out || "/patch-check.log")
  call require rc = 0, "original patch identities"
  address crexx "cd :root"
  address crexx "run cmake -E copy_directory os/pdos/source :source"
  call require rc = 0, "prepare OS source"
  address crexx "run cmake -E make_directory :runtime"
  call require rc = 0, "create selected runtime directory"
  runtime_inputs = readlines(root || "/os/pdos/runtime-inputs.txt")
  do i = 1 to runtime_inputs.0
    file = strip(runtime_inputs[i])
    call require words(file) = 1 & pos("/",file) = 0 & pos("..",file) = 0, "runtime input filename"
    from = root || "/pdpclib/" || file
    if file = "pdptop.mac" then from = root || "/pdpclib/profiles/pdos-zarch/pdptop.mac"
    target = runtime || "/" || file
    address crexx "run cmake -E copy :from :target"
    call require rc = 0, "prepare maintained runtime " || file
  end
  address crexx "cd :source"
  manifest = root || "/os/pdos/prepared.sha256"
  address system "shasum -a 256 -c " || shellquote(manifest) || " > " || shellquote(out || "/prepared-check.log")
  call require rc = 0, "prepared source matches maintained selection"
  address crexx "cd :root"
  if action = "check" then do
    negative = out || "/before-0005"
    address crexx "run cmake -E copy_directory :source :negative"
    call require rc = 0, "prepare pre-repair fault control"
    patch = root || "/os/pdos/patches/original/pdos64/0005-checked-dasd-writes-and-console-wrap.patch"
    address system "env " || shellquote("TMPDIR=" || out || "/tmp") || " patch --batch --fuzz=0 -R -p1 -d " || shellquote(negative) || " -i " || shellquote(patch) || " > " || shellquote(out || "/reverse-0005.log")
    call require rc = 0, "restore pre-repair control only in generated copy"
    do version = 1 to 2
      actual = negative
      if version = 2 then actual = source
      qa = out || "/qa-" || version
      address crexx "run cmake -E make_directory :qa"
      call require rc = 0, "create fault-control output"
      call extract actual || "/s370/pdos.c", qa
      fixture = root || "/os/pdos/tests/io-repair.c"
      program = qa || "/check"
      address crexx "run clang -std=c11 -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer -I :qa :fixture -o :program"
      call require rc = 0, "compile real-function fault controls"
      do mode = 1 to 2
        check = word("record console",mode)
        address system shellquote(program) || " " || check || " > " || shellquote(qa || "/" || check || ".log") || " 2>&1"
        if version = 1 then call require rc = 1, "pre-repair " || check || " control fails"
        else call require rc = 0, "repaired " || check || " passes ASAN/UBSAN"
      end
    end
    say "Maintained OS/runtime source hashes pass; old fault controls fail; repaired functions pass ASAN/UBSAN."
    return 0
  end
  compiler = root || "/build/classic-cc/mvs/gcc/mf-classic-cc"
  address crexx "run test -x :compiler"
  call require rc = 0, "build Classic C MVS compiler first"
  compiled = out || "/compiled"
  address crexx "run cmake -E make_directory :compiled"
  call require rc = 0, "create compiler output"
  flags = "-Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I. -I../pdpclib -DUSE_MEMMGR"
  inputs = readlines(root || "/os/pdos/compile-inputs.txt")
  outputs = .string[]
  do i = 1 to inputs.0
    member = word(inputs[i],1)
    relative = word(inputs[i],2)
    call require words(inputs[i]) = 2, "compile input manifest row"
    directory = source || "/" || left(relative,pos("/",relative)-1)
    file = substr(relative,pos("/",relative)+1)
    output = compiled || "/" || member || ".asm"
    address crexx "cd :directory"
    address system shellquote(compiler) || " " || flags || " " || shellquote(file) || " -o " || shellquote(output) || " > " || shellquote(compiled || "/" || member || ".log") || " 2>&1"
    call require rc = 0, member || " C-to-assembly-text compile"
    outputs[i] = output
    say member "C-to-assembly-text pass"
  end
  address crexx "cd :root"
  hashes = .string[]
  address crexx "run shasum -a 256 :outputs[]" output hashes
  call require rc = 0, "compiler output identities"
  manifest = out || "/compiled.sha256"
  address crexx "run cmake -E rm -f :manifest"
  do i = 1 to hashes.0
    call lineout manifest,hashes[i]
  end
  call lineout manifest
  say inputs.0 "Classic C compile units pass; assembly, link, IPL and guest acceptance remain open."
  return 0

extract: procedure = .int
  arg source = .string, out = .string
  lines = readlines(source)
  record = out || "/record.inc"; console = out || "/console.inc"
  address crexx "run cmake -E rm -f :record :console"
  call require rc = 0, "reset extracted controls"
  active = 0; records = 0; consoles = 0
  do i = 1 to lines.0
    if pos("static int pdos64PdsRecord(P",lines[i]) = 1 then active = 1
    if pos("static int pdos64PdsCloseWrite",lines[i]) = 1 then active = 0
    if lines[i] = "static void write3270(char *buf, size_t lenbuf, int cr)" then active = 2
    if lines[i] = "static int cprintf(char *format, ...)" then active = 0
    if active = 1 then do
      call lineout record,lines[i]
      records = records + 1
    end
    if active = 2 then do
      call lineout console,lines[i]
      consoles = consoles + 1
    end
  end
  call lineout record; call lineout console
  call require records > 20 & consoles > 20, "extract real repaired functions"
  return 0

shellquote: procedure = .string
  arg value = .string
  return "'" || changestr("'", value, "'\''") || "'"

require: procedure = .int
  arg condition = .int, detail = .string
  if condition <> 1 then do
    say "FAILED:" detail
    exit 1
  end
  return 0

usage: procedure = .int
  say "usage: crexx os/pdos/build.crexx --args check|compile [build/pdos/output]"
  return 2
