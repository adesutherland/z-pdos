/* Phase-3/4 successor proof: Classic C31 service and nested shared-U call.
 * Binary core/Hercules handling lives in the test fixture adapter. */
options levelb
import rxfnsb
main: procedure = .int
  arg args = .string[]
  if args.0 <> 7 then do
    say "Usage: crexx -nokeep pdos/scripts/two-space-next.crexx --args FRESH_BUILD_DIR GNU_AS GNU_LD CLASSIC_CC CLASSIC_AS CLASSIC_LD HERCULES"
    return 2
  end
  work = args.1
  gnuas = args.2; gnuld = args.3
  classiccc = args.4; classicas = args.5; classicld = args.6
  herctool = args.7
  if left(work,11) <> "build/pdos/" | pos("..",work) > 0 then return 2
  address crexx "run test ! -e :work"
  if rc <> 0 then return 2
  lines = .string[]
  address crexx "pwd" output lines
  root = strip(lines.1)
  out = root || "/" || work
  address crexx "run mkdir -p :out"
  if rc <> 0 then return rc
  compiled = out || "/TWOSVC.asm"
  object = out || "/TWOSVC.obj"
  binary = out || "/TWOSVC.bin"
  map = out || "/TWOSVC.map"
  gateasm = out || "/TSG.asm"; gateobj = out || "/TSG.obj"
  datasm = out || "/TSD.asm"; datobj = out || "/TSD.obj"
  memasm = out || "/TSM.asm"; memobj = out || "/TSM.obj"
  realasm = out || "/TSR.asm"; realobj = out || "/TSR.obj"
  placeasm = out || "/TSP.asm"; placeobj = out || "/TSP.obj"
  tlbobj = out || "/TSTLB.obj"
  entryobj = out || "/TSMENTRY.obj"
  keyobj = out || "/TSMKEY.obj"
  chanasm = out || "/TSC.asm"; chanobj = out || "/TSC.obj"
  chansupport = out || "/TSCH.obj"
  dsasm = out || "/TSK.asm"; dsobj = out || "/TSK.obj"
  cmsasm = out || "/TSH.asm"; cmsobj = out || "/TSH.obj"
  cmsfileasm = out || "/TSIF.asm"; cmsfileobj = out || "/TSIF.obj"
  cmscursorasm = out || "/TSI.asm"; cmscursorobj = out || "/TSI.obj"
  tsoasm = out || "/TST.asm"; tsoobj = out || "/TST.obj"
  datmap = out || "/TSD.map"; datbin = out || "/TSD.bin"
  address crexx "cd pdos/src"
  address crexx "run :classiccc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I. -I../../pdpclib/src -DUSE_MEMMGR twospace_service.c -o :compiled"
  if rc <> 0 then return rc
  address crexx "run :classiccc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I. twospace_gate.c -o :gateasm"
  if rc <> 0 then return rc
  address crexx "run :classiccc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I. twospace_dat.c -o :datasm"
  if rc <> 0 then return rc
  address crexx "run :classiccc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I. twospace_memory.c -o :memasm"
  if rc <> 0 then return rc
  address crexx "run :classiccc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I. twospace_real.c -o :realasm"
  if rc <> 0 then return rc
  address crexx "run :classiccc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I. twospace_placement.c -o :placeasm"
  if rc <> 0 then return rc
  address crexx "run :classiccc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I. twospace_channel.c -o :chanasm"
  if rc <> 0 then return rc
  address crexx "run :classiccc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I. twospace_dataset.c -o :dsasm"
  if rc <> 0 then return rc
  address crexx "run :classiccc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I. twospace_cms.c -o :cmsasm"
  if rc <> 0 then return rc
  address crexx "run :classiccc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I. twospace_cmsfile.c -o :cmsfileasm"
  if rc <> 0 then return rc
  address crexx "run :classiccc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I. twospace_cmscursor.c -o :cmscursorasm"
  if rc <> 0 then return rc
  address crexx "run :classiccc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I. twospace_tso.c -o :tsoasm"
  if rc <> 0 then return rc
  address crexx "cd :root"
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :compiled :object"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :gateasm :gateobj"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :datasm :datobj"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :memasm :memobj"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :realasm :realobj"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :placeasm :placeobj"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :chanasm :chanobj"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :dsasm :dsobj"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :cmsasm :cmsobj"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :cmsfileasm :cmsfileobj"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :cmscursorasm :cmscursorobj"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :tsoasm :tsoobj"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile z900 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage pdos/src/twospace_channel.asm :chansupport"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage pdos/src/twospace_tlb.asm :tlbobj"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage pdos/src/twospace_entry.asm :entryobj"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage pdos/src/twospace_key.asm :keyobj"
  if rc <> 0 then return rc
  address crexx "run :classicld --oformat binary --image-base 33554432 -e TSMENTRY -Map :map -o :binary :entryobj :object :gateobj :datobj :memobj :realobj :placeobj :chanobj :dsobj :cmsobj :cmsfileobj :cmscursorobj :tsoobj :chansupport :tlbobj :keyobj"
  if rc <> 0 then return rc
  placemap = out || "/TSP.map"; placebin = out || "/TSP.bin"
  dattest = out || "/dat-test"; placetest = out || "/placement-test"
  gatetest = out || "/gate-test"; memtest = out || "/memory-test"
  chantest = out || "/channel-test"
  dstest = out || "/dataset-test"
  cmstest = out || "/cms-header-test"
  cmsfiletest = out || "/cms-file-test"
  cmscursortest = out || "/cms-cursor-test"
  address crexx "run :classicld --oformat binary --image-base 50331648 -e TSDINIT -Map :datmap -o :datbin :datobj"
  if rc <> 0 then return rc
  address crexx "run :classicld --oformat binary --image-base 50331648 -e TSPINIT -Map :placemap -o :placebin :placeobj"
  if rc <> 0 then return rc
  address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -fsanitize=address,undefined -fno-omit-frame-pointer -I pdos/src pdos/src/twospace_dat.c pdos/tests/two-space/dat.c -o :dattest"
  if rc <> 0 then return rc
  address crexx "run :dattest"
  if rc <> 0 then return rc
  capacitytest = out || "/fixture-capacity-test"
  address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -fsanitize=address,undefined -fno-omit-frame-pointer -I pdos/src pdos/src/twospace_dat.c pdos/src/twospace_fixture.c pdos/tests/two-space/fixture_capacity.c -o :capacitytest"
  if rc <> 0 then return rc
  address crexx "run :capacitytest"
  if rc <> 0 then return rc
  address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -fsanitize=address,undefined -fno-omit-frame-pointer -I pdos/src pdos/src/twospace_placement.c pdos/tests/two-space/placement.c -o :placetest"
  if rc <> 0 then return rc
  address crexx "run :placetest"
  if rc <> 0 then return rc
  address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -fsanitize=address,undefined -fno-omit-frame-pointer -I pdos/src pdos/src/twospace_dat.c pdos/src/twospace_fixture.c pdos/src/twospace_gate.c pdos/tests/two-space/gate.c -o :gatetest"
  if rc <> 0 then return rc
  address crexx "run :gatetest"
  if rc <> 0 then return rc
  address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -fsanitize=address,undefined -fno-omit-frame-pointer -I pdos/src pdos/src/twospace_dat.c pdos/src/twospace_real.c pdos/src/twospace_placement.c pdos/src/twospace_memory.c pdos/src/twospace_gate.c pdos/tests/two-space/memory.c -o :memtest"
  if rc <> 0 then return rc
  address crexx "run :memtest"
  if rc <> 0 then return rc
  address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -fsanitize=address,undefined -fno-omit-frame-pointer -I pdos/src pdos/src/twospace_channel.c pdos/tests/two-space/channel.c -o :chantest"
  if rc <> 0 then return rc
  address crexx "run :chantest"
  if rc <> 0 then return rc
  address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -fsanitize=address,undefined -fno-omit-frame-pointer -I pdos/src pdos/src/twospace_dataset.c pdos/tests/two-space/dataset.c -o :dstest"
  if rc <> 0 then return rc
  address crexx "run :dstest"
  if rc <> 0 then return rc
  address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -fsanitize=address,undefined -fno-omit-frame-pointer -I pdos/src pdos/src/twospace_cms.c pdos/tests/two-space/cms.c -o :cmstest"
  if rc <> 0 then return rc
  address crexx "run :cmstest"
  if rc <> 0 then return rc
  address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -fsanitize=address,undefined -fno-omit-frame-pointer -I pdos/src pdos/src/twospace_cmsfile.c pdos/tests/two-space/cmsfile.c -o :cmsfiletest"
  if rc <> 0 then return rc
  address crexx "run :cmsfiletest"
  if rc <> 0 then return rc
  address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -fsanitize=address,undefined -fno-omit-frame-pointer -I pdos/src pdos/src/twospace_cmscursor.c pdos/tests/two-space/cmscursor.c -o :cmscursortest"
  if rc <> 0 then return rc
  address crexx "run :cmscursortest"
  if rc <> 0 then return rc
  datemit = out || "/dat-emit"
  address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -I pdos/src pdos/src/twospace_dat.c pdos/src/twospace_fixture.c pdos/src/twospace_placement.c pdos/tests/two-space/dat_emit.c -o :datemit"
  if rc <> 0 then return rc
  asobject = out || "/service.o"
  elf = out || "/service.elf"
  address crexx "run :gnuas -m64 -march=z900 pdos/tests/two-space/service.S -o :asobject"
  if rc <> 0 then return rc
  address crexx "run :gnuld -m elf64_s390 -T pdos/tests/two-space/service.ld :asobject -o :elf"
  if rc <> 0 then return rc
  runout = out || "/run"
  address crexx "run env PYTHONDONTWRITEBYTECODE=1 python3 pdos/tests/two-space/service_machine.py :elf :binary :runout :gnuas :gnuld :classiccc :classicas :classicld :herctool :datemit"
  return rc
