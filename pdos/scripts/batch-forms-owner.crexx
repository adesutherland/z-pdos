/* SPDX-License-Identifier: MIT; build isolated native ownership test modules. */
options levelb
import rxfnsb
main: procedure=.int
  arg args=.string[]
  if args.0<>6 then return 2
  i=.int;src=.string;asm=.string;obj=.string
  work=args.1;base=args.2;command=args.3;cc=args.4;classicas=args.5;ld=args.6
  if work<>"build/pdos/batch-sdk/forms-owner" then return 2
  address crexx "run crexx -nokeep pdos/scripts/batch-clean.crexx --args :work"
  if rc<>0 then return rc
  objects=.string[];native=.string[]
  native.1=command||"/part6.obj";native.2=command||"/part1.obj";native.3=command||"/part2.obj"
  native.4=command||"/part5.obj";native.5=command||"/part8.obj";native.6=command||"/part7.obj"
  native.7=base||"/support/MVSSUPA.obj";native.8=command||"/stdlib.obj"
  common="START CTYPE STRING TIME ERRNO ASSERT LOCALE MATH SETJMP SIGNAL MEMMGR"
  do i=1 to words(common)
    native[native.0+1]=base||"/c/objects/"||word(common,i)||".obj"
  end
  do i=1 to 3
    src="pdos/tests/batch/"||word("forms_owner.c forms_owner_child.c",i)
    if i=3 then src="pdos/src/twospace_ui.c"
    asm=work||"/part"||i||".asm";obj=work||"/part"||i||".obj"
    address crexx "run :cc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -DUSE_MEMMGR -S -I pdpclib/src -I pdos/src :src -o :asm"
    if rc<>0 then return rc
    address crexx "run :classicas --profile s370 --capacity-profile desktop --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :asm :obj"
    if rc<>0 then return rc
    objects[i]=obj
  end
  src="pdos/tests/batch/forms_owner.asm";obj=work||"/native.obj"
  address crexx "run :classicas --profile s370 --capacity-profile desktop --macros :src :obj"
  if rc<>0 then return rc
  packer=command||"/pack-tso";ui=objects.3
  do i=1 to 2
    app=word("FOWNER FOWNCH",i);module=work||"/"||app||".rdw";stage=work||"/"||app||".bin";map=work||"/"||app||".map";sourceobj=objects[i]
    extra=.string[]
    if i=1 then extra.1=obj
    address crexx "run :ld --oformat mvs --image-base 0 --amode 31 --rmode ANY -e @@CRT0 -Map :map -o :module :native[] :ui :sourceobj :extra[]"
    if rc<>0 then return rc
    address crexx "run :packer :module :stage classic31"
    if rc<>0 then return rc
  end
  return 0
