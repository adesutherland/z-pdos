/* SPDX-License-Identifier: MIT; review/freeze and maintenance lease required. */
options levelb
import rxfnsb
main: procedure = .int
  arg args=.string[]
  if args.0<4 | args.0>7 then return 2
  media=args.1;herc=args.2;work=args.3;primary=args.4
  if left(work,11)<>"build/pdos/" | pos("..",work)>0 then return 2
  if work<>"build/pdos/batch-sdk/qa" then return 2
  if primary<>"line" & primary<>"3270" then return 2
  model="2";appearance="colour"
  if primary="line" then appearance="mono"
  if args.0>=6 then model=args.6
  if args.0=7 then appearance=args.7
  if model<>"2" & model<>"3" & model<>"4" & model<>"5" then return 2
  if appearance<>"colour" & appearance<>"mono" then return 2
  if primary="line" & (model<>"2" | appearance<>"mono") then return 2
  commands="pdos/tests/batch/sdk-commands.json";profile=.string[]
  profile.1="--batch-dd";profile.2="--batch-sdk";ui=.int;ui=0
  if args.0>=5 then do
    if args.5="jcl" then do
      commands="pdos/tests/batch/jcl-commands.json";profile.2="--batch-jcl"
    end
    else if args.5="ui" then do
      commands="pdos/tests/batch/jcl-ui-commands.json";call arraydrop profile;ui=1
    end
    else if args.5="forms" then do
      if primary="line" then return 2
      commands="pdos/tests/batch/forms-commands.json";call arraydrop profile;profile.1="--batch-forms";ui=1
    end
    else if args.5="forms-complete" then do
      commands="pdos/tests/batch/forms-complete-commands.json";call arraydrop profile;profile.1="--batch-forms-complete";ui=1
    end
    else if args.5="forms-recovery" then do
      commands="pdos/tests/batch/forms-recovery-commands.json";call arraydrop profile;profile.1="--batch-forms-recovery";ui=1
    end
    else return 2
  end
  address crexx "run crexx -nokeep pdos/scripts/batch-clean.crexx --args :work"
  if rc<>0 then return rc
  /* The machine controller creates its output directory itself. */
  address crexx "run cmake -E rm -rf :work"
  if rc<>0 then return rc
  disk=media||"/media/pdos00.cckd";core=media||"-inputs/normal.core";hercules=herc||"/hercules"
  flags=.string[]
  if primary="line" then flags.1="--line-primary"
  else if appearance="colour" then flags.1="--colour"
  address crexx "run python3 -B pdos/tests/two-space/console_machine.py :disk :core :hercules :work --normal --monitor --workbench-normal --model :model --commands :commands :profile[] :flags[]"
  result=rc
  if ui then do
    /* The generic console actor creates the same owned QA directory. Mark it
       even after a failed run so ordinary guarded cleanup can retire it. */
    address crexx "run test -d :work"
    if rc=0 then do
      marker=work||"/.pd033-build"
      address crexx "run test ! -L :work"
      if rc<>0 then return 2
      address crexx "run test ! -L :marker"
      if rc<>0 then return 2
      call lineout marker,"pd033-batch-build-v1"
      call lineout marker
    end
    else if rc<>1 then return rc
  end
  return result
