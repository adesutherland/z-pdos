/* SPDX-License-Identifier: MIT; bounded normal-IPL benchmark media and actor. */
options levelb
import rxfnsb
main: procedure = .int
  arg args = .string[]
  i = .int; row = .string
  if args.0 <> 7 then return 2
  work=args.1; prior=args.2; core=args.3; module=args.4; pack=args.5; herc=args.6; model=args.7
  if left(work,11)<>"build/pdos/" | pos("..",work)>0 then return 2
  if model<>"2" & model<>"5" then return 2
  address crexx "run test ! -e :work"
  if rc<>0 then return 2
  locations=.string[]
  address crexx "pwd" output locations
  root=strip(locations.1); input=root||"/"||work||"-inputs"; media=input||"/media"; base=input||"/base"
  address crexx "run test ! -e :input"
  if rc<>0 then return 2
  address crexx "run mkdir -p :media :base"
  if rc<>0 then return rc
  files=.string[]; source=prior||"/media"
  address crexx "run find :source -maxdepth 1 -type f" output files
  if rc<>0 then return rc
  do i=1 to files.0
    source=files[i]
    if right(source,4)=".bin" | right(source,4)=".sys" | right(source,4)=".exe" then do
      address crexx "run cmake -E copy :source :media"
      if rc<>0 then return rc
    end
  end
  stage=media||"/pd25io.bin"
  address crexx "run :pack :module :stage classic64"
  if rc<>0 then return rc
  before=prior||"/media/ctl.txt"; ctl=media||"/ctl.txt"
  do while lines(before)>0
    row=linein(before)
    if word(row,1)="TSO64.PD25IO" then iterate
    if word(row,1)="PDOS.STORE" then call lineout ctl,"TSO64.PD25IO SEQ pd25io.bin TRK 1 1 0 PS F 18452 18452"
    call lineout ctl,row
  end
  call lineout ctl
  source=prior||"/launch.bin"
  address crexx "run cmake -E copy :source :input"
  if rc<>0 then return rc
  source=prior||"/base/install-ipl"
  address crexx "run cmake -E copy :source :base"
  if rc<>0 then return rc
  address crexx "run crexx -nokeep pdos/scripts/two-space-normal-model.crexx --args :work :input :core :herc :model 3270 monitor pdos/tests/two-space/p6/io-foundation.json"
  return rc
