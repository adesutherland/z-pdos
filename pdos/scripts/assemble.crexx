/* SPDX-License-Identifier: MIT
 * First whole-C object gate; raw support, kernel profile and linking are separate. */
options levelb
import rxfnsb
main: procedure = .int
  arg args = .string[]
  if args.0 > 2 then return 2
  work = "build/pdos/classic"
  if args.0 >= 1 then work = args.1
  if left(work,11) <> "build/pdos/" | length(work) <= 11 | pos("..",work) > 0 then return 2
  address crexx "run crexx -nokeep pdos/scripts/build.crexx --args compile :work"
  if rc <> 0 then return rc
  cli = "build/tools/assembler/mf-classic-as"
  if args.0 = 2 then cli = args.2
  objects = work || "/objects"
  address crexx "run cmake -E make_directory :objects"
  if rc <> 0 then return rc
  inputs = readlines("pdos/scripts/compile-inputs.txt")
  do i = 1 to inputs.0
    member = word(inputs[i],1)
    source = work || "/compiled/" || member || ".asm"
    deck = objects || "/" || member || ".obj"
    address crexx "run cmake -E rm -f :deck"
    if rc <> 0 then return rc
    address crexx "run :cli --profile s370 --capacity-profile desktop --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :source :deck"
    if rc <> 0 then return rc
    say member "Classic object passes"
  end
  say "All 17 C units independently assemble. Raw support, named kernel ISA, linking, IPL and guest acceptance remain open."
  return 0
