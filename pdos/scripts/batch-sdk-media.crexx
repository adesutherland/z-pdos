/* SPDX-License-Identifier: MIT; disposable shared-package proof, no adoption. */
options levelb
import rxfnsb
main: procedure = .int
  arg args=.string[]
  if args.0<9 | args.0>12 then return 2
  work=args.1;prior=args.2;core=args.3;controller=args.4;package=args.5;probe=args.6;herc=args.7;primary=args.8;lab=args.9
  editor=.string
  model="2"
  if args.0>=11 then model=args.11
  if model<>"2" & model<>"3" & model<>"4" & model<>"5" then return 2
  if primary="line" & model<>"2" then return 2
  owner_args=.string[];owner_prepare=.string[];owner_stage=.string[];editor_args=.string[];editor_mode=.int;editor_mode=0
  if args.0=12 then do
    if args.12="forms-owner" then do
      owner_args.1="build/pdos/batch-sdk/forms-owner"
      owner_prepare.1="forms-owner"
    end
    else if args.12="editor" then do
      editor_args.1="--probe";editor_mode=1
    end
    else return 2
  end
  if left(work,11)<>"build/pdos/" | pos("..",work)>0 then return 2
  if work<>"build/pdos/batch-sdk/image" then return 2
  if primary<>"line" & primary<>"3270" then return 2
  location=.string[]
  address crexx "pwd" output location
  root=strip(location.1);input=root||"/"||work||"-inputs";media=input||"/media";support=input||"/base"
  if args.0=12 then do
    if args.12="forms-owner" then owner_stage.1=media
  end
  slot=work||"-inputs"
  address crexx "run crexx -nokeep pdos/scripts/batch-clean.crexx --args :slot"
  if rc<>0 then return rc
  address crexx "run mkdir -p :media :support"
  if rc<>0 then return rc
  from=prior||"/media"
  address crexx "run cmake -E copy_directory :from :media"
  if rc<>0 then return rc
  /* Native ADDRESS needs the current resident U command descriptor/router. */
  from=root||"/build/pdos/batch-sdk/command/u-command.bin"
  address crexx "run cmake -E copy :from :media"
  if rc<>0 then return rc
  packer=root||"/build/pdos/release-021-image3/command/pack-tso"
  extractor="/Users/adrian/CLionProjects/mainframe-cross-sdk/sdk/scripts/pdos64_xmit_unload.py"
  address crexx "run python3 -B pdos/tests/batch/sdk_fixture.py prepare :media :package :controller :probe :packer :extractor :owner_args[]"
  if rc<>0 then return rc
  fixtures=.string
  if args.0>=10 then do
    fixtures=args.10
    if fixtures<>"build/pdos/batch-jcl/fixtures/pdos" then return 2
    address crexx "run python3 -B pdos/tests/batch/jcl_fixture.py prepare :media :fixtures :owner_prepare[]"
    if rc<>0 then return rc
  end
  /* Pin the current native application instead of inheriting an old EDIT. */
  if editor_mode then do
    editor=root||"/build/pdos/batch-sdk/apps/edit.bin"
    address crexx "run python3 -B pdos/tests/editor/payload.py prepare :media :editor :editor_args[]"
    if rc<>0 then return rc
  end
  from=prior||"/launch.bin"
  address crexx "run cmake -E copy :from :input"
  if rc<>0 then return rc
  installer=support||"/install-ipl"
  address crexx "run clang -std=c90 -Wall -Wextra -Werror -pedantic -O2 -DIPL_CYLINDERS=150 pdos/src/install-ipl.c -o :installer"
  if rc<>0 then return rc
  configured=input||"/normal.core"
  address crexx "run python3 -B pdos/tests/two-space/normal_core.py configure :core :configured :model :primary monitor"
  if rc<>0 then return rc
  address crexx "run crexx -nokeep pdos/scripts/two-space-refresh.crexx --args :work :input :configured :herc 150"
  if rc<>0 then return rc
  address crexx "run python3 -B pdos/tests/batch/sdk_fixture.py stage :work :herc :package :lab"
  if rc<>0 then return rc
  if args.0>=10 then do
    address crexx "run python3 -B pdos/tests/batch/jcl_fixture.py stage :work :herc :fixtures :lab :owner_stage[]"
    if rc<>0 then return rc
  end
  if editor_mode then do
    address crexx "run python3 -B pdos/tests/editor/payload.py verify :work :herc :editor :editor_args[]"
    if rc<>0 then return rc
  end
  return rc
