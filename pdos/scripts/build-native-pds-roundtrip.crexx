/* Focused native-file consumer. cREXX owns orchestration; the SDK's existing
   compiler/link/package interface and independent XMIT reader own binaries. */
options levelb
import rxfnsb
main: procedure = .int
  arg args=.string[]
  if args.0<>7 then return 2
  sdkroot=args.1; sdk=args.2; core=args.3; extras=args.4
  out=args.5; reader=args.6; selected_service=args.7
  address crexx "run test ! -e :out"
  if rc<>0 then return 2
  address crexx "run mkdir -p :out"
  if rc<>0 then return rc
  source="pdos/tests/two-space/native_pds_roundtrip.c"
  recipe="pdos/scripts/build-native-pds-roundtrip.crexx"
  consumer=sdkroot||"/sdk/scripts/compiler_sdk_consume.py"
  inputs=.string[]
  call arrayappend inputs,source;call arrayappend inputs,recipe
  call arrayappend inputs,consumer;call arrayappend inputs,reader
  call arrayappend inputs,sdk||"/SDK-MANIFEST.json"
  call arrayappend inputs,selected_service
  call arrayappend inputs,core||"/libnewlib.a"
  call arrayappend inputs,extras||"/libextra.a"
  call arrayappend inputs,extras||"/libm-extra.a"
  adapters=sdkroot||"/libc/src/adapters"
  names="command.h command-internal.h command-text.c cms/command.c cms/command-call.s cms/text-codec.c cms/adapter.c cms/directory.c cms/fst-lookup.s tso/command.c tso/directory.c tso/directory.h tso/entry31-any.asm tso/services.h tso/sdk-application.c"
  i=.int
  do i=1 to words(names)
    call arrayappend inputs,adapters||"/"||word(names,i)
  end
  before=out||"/source-before.sha256"; after=out||"/source-after.sha256"
  call freeze before,inputs
  if rc<>0 then return rc
  build=out||"/consumer"
  address crexx "run python3 -B :consumer --sdk :sdk --profile tso-zos31-v1 --out :build --tso-source :source --command-adapters :adapters --runtime-core :core --runtime-extras :extras --member-prefix IOFLT"
  if rc<>0 then return rc
  service=build||"/candidate-sdk/native/source/mvssupa.obj"
  address crexx "run cmp :selected_service :service"
  if rc<>0 then return rc
  product=build||"/tso-zos31-v1/IOFLT31.XMI"
  readback=out||"/IOFLT31.rdw"
  address crexx "run python3 -B :reader :product :readback --member IOFLT31 --amode 31 --rmode ANY"
  if rc<>0 then return rc
  call freeze after,inputs
  if rc<>0 then return rc
  address crexx "run cmp :before :after"
  if rc<>0 then return rc
  call arrayappend inputs,product;call arrayappend inputs,readback
  call arrayappend inputs,build||"/result.json"
  call arrayappend inputs,build||"/tso-zos31-v1/consumer.obj"
  call arrayappend inputs,build||"/tso-zos31-v1/consumer.elf"
  call freeze out||"/inputs-outputs.sha256",inputs
  if rc<>0 then return rc
  say "NATIVE PDS ROUNDTRIP BUILD PASS"
  return 0

freeze: procedure
  arg path=.string,inputs=.string[]
  hashes=.string[];i=.int
  address crexx "run shasum -a 256 :inputs[]" output hashes
  if rc<>0 then return
  do i=1 to hashes.0
    call lineout path,hashes[i]
  end
  call lineout path
