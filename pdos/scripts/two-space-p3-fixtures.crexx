/* SPDX-License-Identifier: MIT
 * Native CMS file ownership controls for the P3 application-call gate. */
options levelb
import rxfnsb
main: procedure = .int
  arg args = .string[]
  i = .int
  if args.0 <> 3 & args.0 <> 5 then return 2
  work = args.1; classicas = args.2; classicld = args.3
  if left(work,11) <> "build/pdos/" | pos("..",work) > 0 then return 2
  address crexx "run test ! -e :work"
  if rc <> 0 then return 2
  address crexx "run mkdir -p :work"
  if rc <> 0 then return rc
  names = "cms-file-parent cms-file-child cms-fault-parent cms-fault-child"
  members = "D0FILEPA D0FILECH D0FLTPA D0FLTCH"
  source_inputs = .string[]
  do i = 1 to words(names)
    name = word(names,i); member = word(members,i)
    source = "pdos/tests/two-space/p3/" || name || ".asm"
    source_inputs[i] = source
    object = work || "/" || member || ".obj"
    module = work || "/" || member || ".module"
    address crexx "run :classicas --profile s370 --capacity-profile desktop --macros :source :object"
    if rc <> 0 then return rc
    address crexx "run :classicld --oformat cms --image-base 35651584 --amode 31 --rmode ANY -e @@MAIN -o :module :object"
    if rc <> 0 then return rc
  end
  hashes = .string[]
  address crexx "run shasum -a 256 :source_inputs[]" output hashes
  if rc <> 0 then return rc
  do i = 1 to hashes.0
    call lineout work || "/source.sha256",hashes[i]
  end
  call lineout work || "/source.sha256"
  if args.0 = 5 then do
    cc = args.4; library = args.5
    adapter_asm = work || "/FILECON.asm"; adapter = work || "/FILECON.obj"
    address crexx "run :cc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -DTSU_NATIVE_FILES -S -I pdpclib/src pdos/src/twospace_pcomm.c -o :adapter_asm"
    if rc <> 0 then return rc
    address crexx "run :classicas --profile s370 --capacity-profile desktop --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :adapter_asm :adapter"
    if rc <> 0 then return rc
    stdio_source = library || "/check/source/pdpclib/stdio.c"
    stdio_asm = work || "/FILESTD.asm"; stdio = work || "/FILESTD.obj"
    address crexx "run :cc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I pdpclib/src -DUSE_MEMMGR -D__aopen=tsuopen -D__aread=tsuread -D__awrite=tsuwrite -D__aclose=tsuclose -D__dynal=tsudyn :stdio_source -o :stdio_asm"
    if rc <> 0 then return rc
    address crexx "run :classicas --profile s370 --capacity-profile desktop --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :stdio_asm :stdio"
    if rc <> 0 then return rc
    entry = work || "/FILESTART.obj"
    address crexx "run :classicas --profile s370 --capacity-profile desktop --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage pdos/src/twospace_pcomm.asm :entry"
    if rc <> 0 then return rc
    do i = 1 to 4
      member = word("D0TFPA D0TFCH D0TFLPA D0TFLCH",i)
      role = "parent"
      if i = 2 | i = 4 then role = "child"
      source = "pdos/tests/two-space/p3/tso-file-" || role || ".c"
      asm = work || "/" || member || ".asm"; object = work || "/" || member || ".obj"
      expected = "-DP3_EXPECT=37"
      if i = 3 then expected = "-DP3_EXPECT=12"
      address crexx "run :cc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I pdpclib/src -DUSE_MEMMGR :expected :source -o :asm"
      if rc <> 0 then return rc
      address crexx "run :classicas --profile s370 --capacity-profile desktop --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :asm :object"
      if rc <> 0 then return rc
      stub_source = "pdos/tests/two-space/p3/" || word("tso-file-link tso-file-exit tso-fault-link tso-fault-exit",i) || ".asm"
      stub = work || "/" || member || "-stub.obj"
      address crexx "run :classicas --profile s370 --capacity-profile desktop --macros :stub_source :stub"
      if rc <> 0 then return rc
      objects = .string[]
      objects[1] = entry; objects[2] = library || "/c/objects/START.obj"
      objects[3] = library || "/support/MVSSUPA.obj"
      objects[4] = stdio; objects[5] = adapter
      common = "STDLIB CTYPE STRING TIME ERRNO ASSERT LOCALE MATH SETJMP SIGNAL MEMMGR"
      do j = 1 to words(common)
        objects[j+5] = library || "/c/objects/" || word(common,j) || ".obj"
      end
      objects[17] = object; objects[18] = stub
      module = work || "/" || member || ".rdw"
      address crexx "run :classicld --oformat mvs --image-base 0 --amode 31 --rmode ANY -e @@MAIN -o :module :objects[]"
      if rc <> 0 then return rc
    end
  end
  return 0
