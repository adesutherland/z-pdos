/* SPDX-License-Identifier: MIT; source-built U PCOMM and C presentation. */
options levelb
import rxfnsb
main: procedure = .int
  arg args = .string[]
  i = .int
  source = .string; flag = .string; asm = .string; object = .string
  if args.0 <> 5 then return 2
  work = args.1; base = args.2; cc = args.3; classicas = args.4; linker = args.5
  if left(work,11) <> "build/pdos/" | pos("..",work) > 0 then return 2
  address crexx "run test ! -e :work"
  if rc <> 0 then return 2
  address crexx "run mkdir -p :work"
  if rc <> 0 then return rc
  sources = .string[]; flags = .string[]; objects = .string[]
  sources[1] = base || "/check/source/pdpclib/stdio.c"
  flags[1] = "-D__aopen=tsuopen -D__aread=tsuread -D__awrite=tsuwrite -D__aclose=tsuclose -D__dynal=tsudyn"
  sources[2] = "pdos/src/twospace_pcomm.c"; flags[2] = "-DTSU_NATIVE_FILES"
  sources[3] = "pdos/src/pcomm.c"; flags[3] = "-DPDOS_TWO_SPACE"
  sources[4] = "pdos/src/twospace_ui.c"; flags[4] = ""
  do i = 1 to 4
    source = sources[i]; flag = flags[i]; asm = work || "/part" || i || ".asm"; object = work || "/part" || i || ".obj"
    address system quote(cc) || " -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -DUSE_MEMMGR " || flag || " -S -I pdpclib/src -I pdos/src " || quote(source) || " -o " || quote(asm)
    if rc <> 0 then return rc
    address crexx "run :classicas --profile s370 --capacity-profile desktop --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :asm :object"
    if rc <> 0 then return rc
    objects[i] = object
  end
  sources[5] = "pdos/src/twospace_pcomm.asm"; sources[6] = "pdos/src/twospace_ui.asm"
  do i = 5 to 6
    source = sources[i]; object = work || "/part" || i || ".obj"
    address crexx "run :classicas --profile s370 --capacity-profile desktop --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :source :object"
    if rc <> 0 then return rc
    objects[i] = object
  end
  source = "pdpclib/src/stdlib.c"; asm = work || "/stdlib.asm"; object = work || "/stdlib.obj"
  address crexx "run :cc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -DUSE_MEMMGR -DMULMEM -DPDP_HEAP_CHUNK_BYTES=16769024 -S -I pdpclib/src :source -o :asm"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --capacity-profile desktop --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :asm :object"
  if rc <> 0 then return rc
  command_stdlib = object
  native = .string[]
  native[1] = objects[5]; native[2] = objects[1]; native[3] = objects[2]
  native[4] = objects[3]; native[5] = objects[4]; native[6] = objects[6]
  native[7] = base || "/support/MVSSUPA.obj"
  native[8] = command_stdlib
  common = "START CTYPE STRING TIME ERRNO ASSERT LOCALE MATH SETJMP SIGNAL MEMMGR"
  do i = 1 to words(common)
    native[i+8] = base || "/c/objects/" || word(common,i) || ".obj"
  end
  module = work || "/PCOMM.rdw"; map = work || "/PCOMM.map"
  address crexx "run :linker --oformat mvs --image-base 0 --amode 31 --rmode ANY -e @@CRT0 -Map :map -o :module :native[]"
  if rc <> 0 then return rc
  pack = work || "/pack-tso"; stage = work || "/u-command.bin"
  address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -I pdos/src pdos/src/twospace_tso.c pdos/tests/two-space/tso_pack.c -o :pack"
  if rc <> 0 then return rc
  address crexx "run :pack :module :stage classic31"
  if rc <> 0 then return rc
  inputs = sources; headers = .string[]; hashes = .string[]
  inputs[inputs.0+1] = "pdpclib/src/stdlib.c"
  inputs[inputs.0+1] = "pdos/scripts/two-space-command.crexx"
  inputs[inputs.0+1] = "pdos/src/twospace_ui.h"
  inputs[inputs.0+1] = "pdos/src/twospace_abi.h"
  inputs[inputs.0+1] = "pdos/src/twospace_tso.h"
  inputs[inputs.0+1] = "pdos/src/twospace_tso.c"
  inputs[inputs.0+1] = "pdos/src/zpdos-version.h"
  inputs[inputs.0+1] = "pdos/tests/two-space/tso_pack.c"
  address crexx "run rg --files pdpclib/src" output headers
  if rc <> 0 then return rc
  address crexx "run shasum -a 256 :inputs[] :headers[] :native[] :cc :classicas :linker" output hashes
  if rc <> 0 then return rc
  do i = 1 to hashes.0
    call lineout work||"/inputs.sha256",hashes[i]
  end
  call lineout work||"/inputs.sha256"
  hashes = .string[]
  address crexx "run shasum -a 256 :module :stage :pack" output hashes
  if rc <> 0 then return rc
  do i = 1 to hashes.0
    call lineout work||"/outputs.sha256",hashes[i]
  end
  call lineout work||"/outputs.sha256"
  return 0
quote: procedure = .string
  arg value = .string
  return "'" || changestr("'",value,"'\''") || "'"
