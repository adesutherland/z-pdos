/* SPDX-License-Identifier: MIT; maintained C console app and focused clients. */
options levelb
import rxfnsb
main: procedure = .int
  arg args=.string[]
  i=.int;source=.string;asm=.string;object=.string
  if args.0<>6 then return 2
  work=args.1;library=args.2;cc=args.3;classicas=args.4;linker=args.5;kind=args.6
  if left(work,11)<>"build/pdos/" | pos("..",work)>0 then return 2
  if kind<>"graph" & kind<>"family" & kind<>"recovery" & kind<>"dbcs" then return 2
  address crexx "run test ! -e :work"
  if rc<>0 then return 2
  address crexx "run mkdir -p :work"
  if rc<>0 then return rc
  sources=.string[];objects=.string[]
  sources[1]="pdos/tests/two-space/p4/stage3-"||kind||".c"
  if kind="dbcs" then sources[1]="pdos/tests/two-space/p4/stage3-family.c"
  if kind="graph" then sources[1]="pdos/src/apps/diskmap.c"
  modules="ui console 3270 workbench surface history display"
  do i=1 to words(modules)
    sources[i+1]="pdos/src/twospace_"||word(modules,i)||".c"
  end
  do i=1 to sources.0
    source=sources[i];asm=work||"/part"||i||".asm";object=work||"/part"||i||".obj"
    flag="-DFAM_DBCS=0"
    if kind="dbcs" then flag="-DFAM_DBCS=1"
    address crexx "run :cc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -DUSE_MEMMGR :flag -S -I pdpclib/src -I pdos/src :source -o :asm"
    if rc<>0 then return rc
    address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :asm :object"
    if rc<>0 then return rc
    objects[i]=object
  end
  source="pdos/src/twospace_ui.asm";object=work||"/ui.obj"
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros :source :object"
  if rc<>0 then return rc
  objects[objects.0+1]=object
  native=.string[];native[1]=library||"/entry.obj";native[2]=library||"/stdio.obj";native[3]=library||"/console.obj"
  base=library||"/base";common="START STDLIB CTYPE STRING TIME ERRNO ASSERT LOCALE MATH SETJMP SIGNAL MEMMGR"
  do i=1 to words(common)
    native[i+3]=base||"/c/objects/"||word(common,i)||".obj"
  end
  native[16]=base||"/support/MVSSUPA.obj"
  module=work||"/D4CONAPP.rdw";map=work||"/D4CONAPP.map"
  address crexx "run :linker --oformat mvs --image-base 0 --amode 31 --rmode ANY -e @@MAIN -Map :map -o :module :native[] :objects[]"
  return rc
