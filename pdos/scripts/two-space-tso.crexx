/* SPDX-License-Identifier: MIT
 * Host and Classic C31 proof of the bounded successor TSO input/materializer.
 * Inputs are unchanged native load-module record streams in ignored build/.
 */
options levelb
import rxfnsb
main: procedure = .int
  arg args = .string[]
  if args.0 <> 6 & args.0 <> 7 then do
    say "usage: crexx -nokeep pdos/scripts/two-space-tso.crexx --args FRESH-build/pdos/work PINNED_RXV31_RDW PINNED_RXV64_RDW CLASSIC_CC CLASSIC_AS CLASSIC_LD [PINNED_RXV24_RDW]"
    return 2
  end
  work = args.1; tso31 = args.2; tso64 = args.3
  classiccc = args.4; classicas = args.5; classicld = args.6
  if args.0 = 7 then tso24 = args.7
  if left(work,11) <> "build/pdos/" | length(work) <= 11 | pos("..",work) > 0 then do
    say "fresh build/pdos/ output path required"
    return 2
  end
  if left(tso31,1) <> "/" | left(tso64,1) <> "/" then do
    say "absolute input paths required"
    return 2
  end
  if args.0 = 7 then do
    if left(tso24,1) <> "/" then do
      say "absolute TSO24 input path required"
      return 2
    end
    address crexx "run test -f :tso24"
    if rc <> 0 then do
      say "TSO24 input missing"
      return 2
    end
    hashes24 = .string[]
    address crexx "run shasum -a 256 :tso24" output hashes24
    if rc <> 0 | word(hashes24.1,1) <> "5d0159c02484f8dfd28ede0f25a3f262006b89fbee52a9ae8c9a152d6f13f356" then do
      say "TSO24 input hash mismatch"
      return 2
    end
  end
  address crexx "run test ! -e :work"
  if rc <> 0 then do
    say "output path already exists"
    return 2
  end
  address crexx "run test -f :tso31"
  if rc <> 0 then do
    say "TSO31 input missing"
    return 2
  end
  address crexx "run test -f :tso64"
  if rc <> 0 then do
    say "TSO64 input missing"
    return 2
  end
  hashes = .string[]
  address crexx "run shasum -a 256 :tso31" output hashes
  if rc <> 0 | word(hashes.1,1) <> "77b689a3c64bad63996031654dfc353d357b9c2616da01c65a9ea3e2c09c2cc9" then do
    say "TSO31 input hash mismatch"
    return 2
  end
  hashes64 = .string[]
  address crexx "run shasum -a 256 :tso64" output hashes64
  if rc <> 0 | word(hashes64.1,1) <> "dc5210b04cabf93d22942b0955ccf9bf63f7e0d4334a88e2a04e8705484339b6" then do
    say "TSO64 input hash mismatch"
    return 2
  end
  lines = .string[]
  address crexx "pwd" output lines
  root = strip(lines.1)
  out = root || "/" || work
  address crexx "run mkdir -p :out"
  if rc <> 0 then return rc
  host = out || "/tso-host-test"
  packer = out || "/tso-pack"
  stage = out || "/tso31-rxvm.bin"
  stage64 = out || "/tso64-rxvm.bin"
  stage24 = out || "/tso24-rxvm.bin"
  legacy = out || "/legacy-loader.o"
  asm = out || "/TST.asm"
  obj = out || "/TST.obj"
  binary = out || "/TST.bin"
  mapfile = out || "/TST.map"
  address crexx "run clang -std=c89 -O1 -g -Wno-format -fsanitize=address,undefined -fno-omit-frame-pointer -I pdos/src -c pdos/src/pdosutil.c -o :legacy"
  if rc <> 0 then return rc
  address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -fsanitize=address,undefined -fno-omit-frame-pointer -I pdos/src pdos/src/twospace_tso.c pdos/tests/two-space/tso_pack.c -o :packer"
  if rc <> 0 then return rc
  address crexx "run :packer :tso31 :stage"
  if rc <> 0 then return rc
  address crexx "run :packer :tso64 :stage64 64"
  if rc <> 0 then return rc
  if args.0 = 7 then do
    address crexx "run :packer :tso24 :stage24 24"
    if rc <> 0 then return rc
  end
  address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -fsanitize=address,undefined -fno-omit-frame-pointer -I pdos/src pdos/src/twospace_tso.c pdos/tests/two-space/tso.c :legacy -o :host"
  if rc <> 0 then return rc
  if args.0 = 7 then
    address crexx "run :host :tso31 :tso64 :stage :stage64 :tso24 :stage24"
  else
    address crexx "run :host :tso31 :tso64 :stage :stage64"
  if rc <> 0 then return rc
  address crexx "run :classiccc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I pdos/src pdos/src/twospace_tso.c -o :asm"
  if rc <> 0 then return rc
  address crexx "run :classicas --profile s370 --literal-limit 4096 --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :asm :obj"
  if rc <> 0 then return rc
  address crexx "run :classicld --oformat binary --image-base 33554432 -Map :mapfile -o :binary :obj"
  if rc <> 0 then return rc
  address crexx "run test -s :binary"
  if rc <> 0 then return rc
  if args.0 = 7 then
    say "Pinned TSO24/31/64 ANY native materialization passed; Classic C31 object linked."
  else
    say "Pinned TSO31 and TSO64 ANY native materialization passed; Classic C31 object linked."
  return 0
