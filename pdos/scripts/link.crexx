/* SPDX-License-Identifier: MIT; fresh classic module links and loader checks. */
options levelb
import rxfnsb
main: procedure = .int
  arg args = .string[]
  if args.0 < 3 | args.0 > 4 then return 2
  i = .int
  c = args.1; support = args.2; work = args.3
  do i = 1 to 3
    path = args[i]
    if left(path,11) <> "build/pdos/" | length(path) <= 11 | pos("..",path) > 0 then return 2
  end
  linker = "build/tools/linker/mf-classic-ld"
  if args.0 = 4 then linker = args.4
  address crexx "run cmake -E make_directory :work"
  if rc <> 0 then return rc
  checker = work || "/check-load-module"
  address crexx "run clang -std=c90 -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer -Wno-pointer-to-int-cast -Wno-int-to-pointer-cast -I pdos/src pdos/tests/check-load-module.c pdos/src/pdosutil.c -o :checker"
  if rc <> 0 then return rc
  do module = 1 to 3
    name = word("PLOAD PDOS PCOMM",module)
    result = link_one(c,support,work,checker,linker,name)
    if result <> 0 then return result
  end
  say "PLOAD, PDOS and PCOMM load images pass; disk/boot/application gates are separate."
  return 0

link_one: procedure = .int
  arg c = .string, support = .string, work = .string, checker = .string, linker = .string, name = .string
  i = .int
  common = "STDIO STDLIB CTYPE STRING TIME ERRNO ASSERT LOCALE MATH SETJMP SIGNAL MEMMGR"
  objects = .string[]
  first = "SAPSTART"; native = "SAPSUPA"
  if name = "PCOMM" then do; first = "MVSSTART"; native = "MVSSUPA"; end
  objects[1] = support || "/" || first || ".obj"
  objects[2] = c || "/START.obj"
  objects[3] = support || "/" || native || ".obj"
  do i = 1 to words(common)
    objects[i+3] = c || "/" || word(common,i) || ".obj"
  end
  count = words(common)+4
  objects[count] = c || "/" || name || ".obj"
  if name <> "PCOMM" then do
    extra = "PLOADSUP"
    if name = "PDOS" then extra = "PDOSSUP"
    objects[count+1] = support || "/" || extra || ".obj"
    objects[count+2] = c || "/PDOSUTIL.obj"
  end
  rdw = work || "/" || name || ".mvs"
  map = work || "/" || name || ".map"
  residence = "24"; rmode = "0"
  /* PCOMM is an AM31 application; the kernel loads it above 16 MiB. */
  if name = "PCOMM" then do; residence = "ANY"; rmode = "1"; end
  address crexx "run cmake -E rm -f :rdw :map"
  if rc <> 0 then return rc
  address crexx "run :linker --oformat mvs --image-base 0 --amode 31 --rmode :residence -e @@MAIN -Map :map -o :rdw :objects[]"
  if rc <> 0 then return rc
  entry = ""
  lines = readlines(map)
  do i = 1 to lines.0
    if word(lines[i],1) = "Entry" & word(lines[i],2) = "Point:" then entry = word(lines[i],3)
  end
  if entry = "" then return 1
  do placement = 1 to 2
    base = word("0 2097152",placement)
    binary = work || "/" || name || "-" || base || ".bin"
    address crexx "run cmake -E rm -f :binary"
    if rc <> 0 then return rc
    address crexx "run :linker --oformat binary --image-base :base -e @@MAIN -o :binary :objects[]"
    if rc <> 0 then return rc
    address crexx "run :checker :rdw :binary :base :entry :rmode"
    if rc <> 0 then return rc
  end
  say name "fresh link and real-loader reconstruction pass at both bases"
  return 0
