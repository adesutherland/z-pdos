/* SPDX-License-Identifier: MIT; qualified default K/U image selection. */
options levelb
import rxfnsb
main: procedure = .int
  arg args = .string[]
  if args.0 < 2 | args.0 > 4 then return 2
  work = args.1; herc = args.2
  if args.0 = 3 then do
    route = args.3
    if route = "legacy" | route = "sanitize" then do
      legacy_mode = "normal"
      if route = "sanitize" then legacy_mode = "sanitize"
      address crexx "run crexx -nokeep pdos/scripts/one-space-image.crexx --args :work :herc :legacy_mode"
      return rc
    end
    if route <> "normal" & route <> "two-space" then return 2
  end
  gnuas = getenv("ZPDOS_GNU_AS"); gnuld = getenv("ZPDOS_GNU_LD")
  if args.0 = 4 then do
    gnuas = args.3; gnuld = args.4
  end
  paths = .string[]
  if gnuas = "" then do
    address system "command -v s390-linux-gnu-as" output paths
    if rc = 0 & paths.0 > 0 then gnuas = strip(paths.1)
  end
  if gnuld = "" then do
    address system "command -v s390-linux-gnu-ld" output paths
    if rc = 0 & paths.0 > 0 then gnuld = strip(paths.1)
  end
  if left(gnuas,1) <> "/" | left(gnuld,1) <> "/" then do
    say "The K/U default needs absolute GNU s390 tool paths. Set ZPDOS_GNU_AS and ZPDOS_GNU_LD, or pass them as arguments 3 and 4. Use legacy to select the one-space producer."
    return 2
  end
  address crexx "run crexx -nokeep pdos/scripts/two-space-normal.crexx --args :work :gnuas :gnuld :herc"
  return rc
