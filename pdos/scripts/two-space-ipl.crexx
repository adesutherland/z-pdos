/* SPDX-License-Identifier: MIT
 * Source-built, disposable 3390 IPL of the two-space successor fixture.
 * This is a boot-path proof, not a replacement for the released PDOS image.
 */
options levelb
import rxfnsb
main: procedure = .int
  arg args = .string[]
  i = .int
  if args.0 <> 5 & args.0 <> 6 & args.0 <> 7 & args.0 <> 8 & args.0 <> 9 & args.0 <> 10 & args.0 <> 11 & args.0 <> 12 & args.0 <> 13 & args.0 <> 14 & args.0 <> 15 & args.0 <> 16 then return usage()
  if args.0 = 16 then if args.16 <> "image-only" then return usage()
  bare = 0
  if args.0 = 7 then if args.6 = "command" then bare = 1
  work = args.1; core = args.2; gnuas = args.3; gnuld = args.4; hercdir = args.5
  pcomm = ""
  if bare = 1 then pcomm = args.7
  if args.0 >= 14 then do
    pcomm = args.14
    call require left(pcomm,1) = "/", "absolute PCOMM native stage"
    address crexx "run test -f :pcomm"
    call require rc = 0, "PCOMM native stage exists"
  end
  cms24 = ""
  cms24media = ""
  cms31 = ""
  cms31media = ""
  cmsfile = ""
  cmsfilemedia = ""
  cmslibrary = ""
  cmslibrarymedia = ""
  cms24file = ""
  cms24filemedia = ""
  tso31 = ""
  tso31media = ""
  tso64 = ""
  tso64media = ""
  tso24 = ""
  tso24media = ""
  if args.0 >= 6 & bare = 0 then do
    cms24 = args.6
    call require left(cms24,1) = "/", "absolute checked CMS24 stage path"
    address crexx "run test -f :cms24"
    call require rc = 0, "CMS24 stage exists"
    hashes = .string[]
    address crexx "run shasum -a 256 :cms24" output hashes
    call require rc = 0 & word(hashes.1,1) = "04550b86d7bdfa3c9060d9fa154875adf3ccb677d95ba13290836ddc02a8da9e", "pinned unchanged CMS24 v2 stage"
  end
  if args.0 >= 7 & bare = 0 then do
    cms31 = args.7
    call require left(cms31,1) = "/", "absolute checked CMS31 stage path"
    address crexx "run test -f :cms31"
    call require rc = 0, "CMS31 stage exists"
    hashes = .string[]
    address crexx "run shasum -a 256 :cms31" output hashes
    call require rc = 0 & word(hashes.1,1) = "a08f3431407f8efec6b05f1e0580e3f12b76f9865f561dac15b5a90135223ff9", "pinned unchanged CMS31 v2 stage"
  end
  if args.0 >= 8 & bare = 0 then do
    cmsfile = args.8
    call require left(cmsfile,1) = "/", "absolute checked CMS31 file path"
    address crexx "run test -f :cmsfile"
    call require rc = 0, "CMS31 file stage exists"
    hashes = .string[]
    address crexx "run shasum -a 256 :cmsfile" output hashes
    call require rc = 0 & word(hashes.1,1) = "9b436a1eb9f54bbc5c8b8b7caae634bd17dcfae6559d584a1a00a87565cfa5d4", "pinned CMS31 IOQUAL RXBIN stage"
  end
  if args.0 >= 9 & bare = 0 then do
    cmslibrary = args.9
    call require left(cmslibrary,1) = "/", "absolute checked CMS31 library path"
    address crexx "run test -f :cmslibrary"
    call require rc = 0, "CMS31 library stage exists"
    hashes = .string[]
    address crexx "run shasum -a 256 :cmslibrary" output hashes
    call require rc = 0 & word(hashes.1,1) = "296893f0bfec021da5d7707e06faa5094c71c1824e3a2b1c0614e09c97df2e30", "pinned CMS31 LIBRARY RXBIN stage"
  end
  if args.0 >= 10 & bare = 0 then do
    cms24file = args.10
    call require left(cms24file,1) = "/", "absolute checked CMS24 IO24 path"
    address crexx "run test -f :cms24file"
    call require rc = 0, "CMS24 IO24 stage exists"
    hashes = .string[]
    address crexx "run shasum -a 256 :cms24file" output hashes
    call require rc = 0 & word(hashes.1,1) = "1c26a211d061f5b41d1b457d80f1493e9d641592c036b8ade03ded86a76b6b78", "pinned CMS24 IO24 RXBIN stage"
  end
  if args.0 >= 11 & bare = 0 then do
    tso31 = args.11
    call require left(tso31,1) = "/", "absolute checked TSO31 stage path"
    address crexx "run test -f :tso31"
    call require rc = 0, "TSO31 stage exists"
    tsohashes = .string[]
    address crexx "run shasum -a 256 :tso31" output tsohashes
    call require rc = 0 & word(tsohashes.1,1) = "9fffaba3c586c1f361c7ecb87167fb1b8acbb569c267b621187fe95305bce506", "pinned unchanged TSO31 record stage"
  end
  if args.0 >= 12 & bare = 0 then do
    tso64 = args.12
    call require left(tso64,1) = "/", "absolute checked TSO64 ANY stage path"
    address crexx "run test -f :tso64"
    call require rc = 0, "TSO64 ANY stage exists"
    tso64hashes = .string[]
    address crexx "run shasum -a 256 :tso64" output tso64hashes
    call require rc = 0 & word(tso64hashes.1,1) = "bdc2d14439f1a3c90409313a9693672c61187b78277197d4dc2b5634dc19bdd6", "pinned unchanged TSO64 ANY record stage"
  end
  if args.0 >= 13 & bare = 0 then do
    tso24 = args.13
    call require left(tso24,1) = "/", "absolute checked TSO24 stage path"
    address crexx "run test -f :tso24"
    call require rc = 0, "TSO24 stage exists"
    tso24hashes = .string[]
    address crexx "run shasum -a 256 :tso24" output tso24hashes
    call require rc = 0 & word(tso24hashes.1,1) = "1335bd64e276ed5fc76a6198704fdde67f7e1f0748dea2d5f25ab81a53bf666a", "pinned released beta 3 TSO24 record stage"
  end
  call require left(work,11) = "build/pdos/" & length(work) > 11 & pos("..",work) = 0, "fresh owned build path"
  call require left(hercdir,1) = "/", "absolute Hercules tools path"
  address crexx "run test ! -e :work"
  call require rc = 0, "new output directory required"
  locations = .string[]
  address crexx "pwd" output locations
  root = strip(locations.1); out = root || "/" || work
  address crexx "run cmake -E make_directory :out"
  call require rc = 0, "create output"
  realtest = out || "/real-test"
  address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -fsanitize=address,undefined -fno-omit-frame-pointer -I pdos/src pdos/src/twospace_real.c pdos/tests/two-space/real.c -o :realtest"
  call require rc = 0, "real-frame ledger host build"
  address crexx "run :realtest"
  call require rc = 0, "real-frame lifetime and release controls"
  base = work || "/base"
  call runlog "crexx -nokeep pdos/scripts/one-space-image.crexx --args " || shellquote(base) || " " || shellquote(hercdir), out || "/base-build.log"
  classiccc = root || "/build/compiler/mvs/gcc/mf-classic-cc"
  classicas = root || "/build/tools/assembler/mf-classic-as"
  classicld = root || "/build/tools/linker/mf-classic-ld"
  asm = out || "/boot.asm"; obj = out || "/boot.obj"
  module = out || "/boot.mvs"; mapfile = out || "/boot.map"
  boot_sources = "twospace_boot twospace_dat twospace_fixture twospace_real"
  boot_objects = .string[]
  do i = 1 to words(boot_sources)
    name = word(boot_sources,i)
    asm = out || "/" || name || ".asm"
    obj = out || "/" || name || ".obj"
    source = "pdos/src/" || name || ".c"
    address crexx "run :classiccc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I pdos/src -I pdpclib/src -DUSE_MEMMGR :source -o :asm"
    call require rc = 0, "Classic C31 " || name
    address crexx "run :classicas --profile s370 --capacity-profile desktop --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :asm :obj"
    call require rc = 0, "Classic assembler " || name
    boot_objects[i] = obj
  end
  tlbobj = out || "/twospace_tlb.obj"
  address crexx "run :classicas --profile s370 --capacity-profile desktop --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage pdos/src/twospace_tlb.asm :tlbobj"
  call require rc = 0, "Classic assembler single-CPU PTLB"
  c = out || "/base/c/objects"; support = out || "/base/support"
  objects = .string[]
  objects[1] = support || "/SAPSTART.obj"
  objects[2] = c || "/START.obj"
  objects[3] = support || "/SAPSUPA.obj"
  common = "STDIO STDLIB CTYPE STRING TIME ERRNO ASSERT LOCALE MATH SETJMP SIGNAL MEMMGR"
  do i = 1 to words(common)
    objects[i+3] = c || "/" || word(common,i) || ".obj"
  end
  count = words(common)+4
  do i = 1 to boot_objects.0
    objects[count+i-1] = boot_objects[i]
  end
  objects[count+boot_objects.0] = tlbobj
  objects[count+boot_objects.0+1] = support || "/PLOADSUP.obj"
  objects[count+boot_objects.0+2] = c || "/PDOSUTIL.obj"
  address crexx "run :classicld --oformat mvs --image-base 0 --amode 31 --rmode 24 -e @@MAIN -Map :mapfile -o :module :objects[]"
  call require rc = 0, "native C31 IPL stage link"
  launchobj = out || "/launch.o"; launchbin = out || "/launch.bin"
  address crexx "run :gnuas -m64 -march=z900 pdos/tests/two-space/launch.S -o :launchobj"
  call require rc = 0, "real launch stub assembly"
  address crexx "run :gnuld -m elf64_s390 --oformat binary -Ttext 0x800000 -e launch :launchobj -o :launchbin"
  call require rc = 0, "real launch stub link"
  media = out || "/media"
  address crexx "run cmake -E make_directory :media"
  call require rc = 0, "media output"
  pload = media || "/pload.sys"; pdos = media || "/pdos.sys"
  package = media || "/kcore.bin"; config = media || "/config.sys"
  command = media || "/command.exe"
  from = out || "/base/linked/PLOAD-0.bin"
  address crexx "run cmake -E copy :from :pload"
  call require rc = 0, "source-built PLOAD"
  address crexx "run cmake -E copy :module :pdos"
  call require rc = 0, "successor IPL stage"
  from = out || "/base/linked/PCOMM.mvs"
  address crexx "run cmake -E copy :from :command"
  call require rc = 0, "ordinary COMMAND.EXE dataset"
  call runlog "env PYTHONDONTWRITEBYTECODE=1 python3 pdos/tests/two-space/pack_core.py " || shellquote(core) || " " || shellquote(launchbin) || " " || shellquote(package), out || "/package.log"
  call put_binary config,'F0F0F0F940F3F2F7F015'x
  ctl = media || "/ctl.txt"
  call lineout ctl,"PDOS00 3390-1 100"
  call lineout ctl,"PLOAD.SYS SEQ pload.sys TRK 10 1 0 PS F 18452 18452"
  call lineout ctl,"SYSVTOC VTOC CYL 2"
  call lineout ctl,"PDOS.SYS SEQ pdos.sys CYL 1 1 0 PS F 18452 18452"
  call lineout ctl,"CONFIG.SYS SEQ config.sys CYL 1 1 0 PS F 10 10"
  call lineout ctl,"COMMAND.EXE SEQ command.exe CYL 1 1 0 PS F 18452 18452"
  call lineout ctl,"KCORE.BIN SEQ kcore.bin CYL 6 6 0 PS F 18452 18452"
  if cms24 <> "" then do
    cms24media = media || "/cms24-rxvm.bin"
    address crexx "run cmake -E copy :cms24 :cms24media"
    call require rc = 0, "checked CMS24 stage copy"
    call lineout ctl,"CMS24.RXVM SEQ cms24-rxvm.bin CYL 4 1 0 PS F 18452 18452"
  end
  if cms31 <> "" then do
    cms31media = media || "/cms31-rxvm.bin"
    address crexx "run cmake -E copy :cms31 :cms31media"
    call require rc = 0, "checked CMS31 stage copy"
    call lineout ctl,"CMS31.RXVM SEQ cms31-rxvm.bin CYL 7 1 0 PS F 18452 18452"
  end
  if cmsfile <> "" then do
    cmsfilemedia = media || "/cms31-ioqual-rxbin.bin"
    address crexx "run cmake -E copy :cmsfile :cmsfilemedia"
    call require rc = 0, "checked CMS31 file stage copy"
    call lineout ctl,"CMS31.IOQUAL.RXBIN SEQ cms31-ioqual-rxbin.bin CYL 1 1 0 PS F 18452 18452"
  end
  if cmslibrary <> "" then do
    cmslibrarymedia = media || "/cms31-library-rxbin.bin"
    address crexx "run cmake -E copy :cmslibrary :cmslibrarymedia"
    call require rc = 0, "checked CMS31 library stage copy"
    call lineout ctl,"CMS31.LIBRARY.RXBIN SEQ cms31-library-rxbin.bin CYL 4 1 0 PS F 18452 18452"
  end
  if cms24file <> "" then do
    cms24filemedia = media || "/cms24-io24-rxbin.bin"
    address crexx "run cmake -E copy :cms24file :cms24filemedia"
    call require rc = 0, "checked CMS24 file stage copy"
    call lineout ctl,"CMS24.IO24.RXBIN SEQ cms24-io24-rxbin.bin CYL 1 1 0 PS F 18452 18452"
  end
  if tso31 <> "" then do
    tso31media = media || "/tso31-rxvm.bin"
    address crexx "run cmake -E copy :tso31 :tso31media"
    call require rc = 0, "checked TSO31 stage copy"
    call lineout ctl,"TSO31.RXVM SEQ tso31-rxvm.bin CYL 3 1 0 PS F 18452 18452"
  end
  if tso64 <> "" then do
    tso64media = media || "/tso64-rxvm.bin"
    address crexx "run cmake -E copy :tso64 :tso64media"
    call require rc = 0, "checked TSO64 ANY stage copy"
    call lineout ctl,"TSO64.RXVM SEQ tso64-rxvm.bin CYL 2 1 0 PS F 18452 18452"
  end
  if tso24 <> "" then do
    tso24media = media || "/tso24-rxvm.bin"
    address crexx "run cmake -E copy :tso24 :tso24media"
    call require rc = 0, "checked TSO24 stage copy"
    call lineout ctl,"TSO24.RXVM SEQ tso24-rxvm.bin CYL 3 1 0 PS F 18452 18452"
  end
  if pcomm <> "" then do
    pcommmedia = media || "/u-command.bin"
    address crexx "run cmake -E copy :pcomm :pcommmedia"
    call require rc = 0, "U PCOMM native stage"
    call lineout ctl,"U.COMMAND SEQ u-command.bin TRK 10 1 0 PS F 18452 18452"
  end
  if args.0 >= 15 & args.15 <> pcomm then do
    childstage = args.15; childmedia = media || "/pdtest.bin"
    call require left(childstage,1) = "/", "absolute native diagnostic member"
    address crexx "run cmake -E copy :childstage :childmedia"
    call require rc = 0, "native test member stage"
    call lineout ctl,"TSO31.PDTEST SEQ pdtest.bin CYL 1 1 0 PS F 18452 18452"
  end
  storefile = media || "/store.bin"
  address crexx "run env PYTHONDONTWRITEBYTECODE=1 python3 pdos/tests/two-space/store_media.py :storefile"
  call require rc = 0, "preformatted durable output store"
  call lineout ctl,"PDOS.STORE SEQ store.bin CYL 42 1 0 PS F 18452 18452"
  call lineout ctl
  installer = out || "/base/install-ipl"
  address crexx "cd :media"
  call runlog shellquote(hercdir || "/dasdload") || " -bz2 ctl.txt datasets.cckd", media || "/dasdload.log"
  call runlog shellquote(hercdir || "/cckd2ckd") || " -q -cyls 100 datasets.cckd datasets.ckd", media || "/cckd2ckd.log"
  call runlog shellquote(installer) || " datasets.ckd pdos00.ckd pload.sys pdos.sys command.exe config.sys kcore.bin", media || "/ipl-check.log"
  call runlog shellquote(hercdir || "/ckd2cckd") || " -q -bz2 -cyls 100 pdos00.ckd pdos00.cckd", media || "/ckd2cckd.log"
  call runlog shellquote(hercdir || "/cckd2ckd") || " -q -cyls 100 pdos00.cckd readback.ckd", media || "/readback.log"
  call runlog shellquote(installer) || " --compare pdos00.ckd readback.ckd pload.sys pdos.sys command.exe config.sys kcore.bin", media || "/roundtrip-check.log"
  before = out || "/store-before.json"
  call runlog "env PYTHONDONTWRITEBYTECODE=1 python3 " || shellquote(root || "/pdos/tests/two-space/store_check.py") || " " || shellquote(media || "/readback.ckd") || " " || shellquote(before), out || "/store-before.log"
  address crexx "cd :root"
  inputs = .string[]
  inputs[1] = "pdos/src/twospace_boot.c"
  inputs[2] = "pdos/src/twospace_dat.c"
  inputs[3] = "pdos/src/twospace_fixture.c"
  inputs[4] = "pdos/src/twospace_real.c"
  inputs[5] = "pdos/src/twospace_tlb.asm"
  inputs[6] = "pdos/src/twospace_dat.h"
  inputs[7] = "pdos/src/twospace_fixture.h"
  inputs[8] = "pdos/src/twospace_real.h"
  inputs[9] = "pdos/src/pdosutil.c"
  inputs[10] = "pdos/src/pdosutil.h"
  inputs[11] = "pdos/src/install-ipl.c"
  inputs[12] = "pdos/tests/two-space/real.c"
  inputs[13] = "pdos/tests/two-space/launch.S"
  inputs[14] = "pdos/tests/two-space/pack_core.py"
  inputs[15] = "pdos/tests/two-space/ipl_machine.py"
  inputs[16] = "pdos/scripts/two-space-ipl.crexx"
  inputs[17] = core; inputs[18] = gnuas; inputs[19] = gnuld
  inputs[20] = classiccc; inputs[21] = classicas; inputs[22] = classicld
  inputs[23] = hercdir || "/hercules"
  if cms24 <> "" then inputs[24] = cms24
  if cms31 <> "" then inputs[25] = cms31
  if cmsfile <> "" then inputs[26] = cmsfile
  if cmslibrary <> "" then inputs[27] = cmslibrary
  if cms24file <> "" then inputs[28] = cms24file
  if tso31 <> "" then inputs[29] = tso31
  if tso64 <> "" then inputs[30] = tso64
  if tso24 <> "" then inputs[31] = tso24
  inputs[inputs.0+1] = "pdos/tests/two-space/machine_profile.py"
  manifest = out || "/inputs.sha256"
  address system "shasum -a 256 " || quoted(inputs) || " > " || shellquote(manifest)
  call require rc = 0, "successor IPL producer identities"
  outputs = .string[]
  outputs[1] = module; outputs[2] = launchbin; outputs[3] = package
  outputs[4] = command; outputs[5] = media || "/pdos00.ckd"
  outputs[6] = media || "/pdos00.cckd"
  if cms24 <> "" then outputs[7] = cms24media
  if cms31 <> "" then outputs[8] = cms31media
  if cmsfile <> "" then outputs[9] = cmsfilemedia
  if cmslibrary <> "" then outputs[10] = cmslibrarymedia
  if cms24file <> "" then outputs[11] = cms24filemedia
  if tso31 <> "" then outputs[12] = tso31media
  if tso64 <> "" then outputs[13] = tso64media
  if tso24 <> "" then outputs[14] = tso24media
  manifest = out || "/outputs.sha256"
  address system "shasum -a 256 " || quoted(outputs) || " > " || shellquote(manifest)
  call require rc = 0, "successor IPL output identities"
  if args.0 = 16 | bare = 1 then return 0
  disk = media || "/pdos00.cckd"; hercules = hercdir || "/hercules"
  runout = out || "/run"
  check = ""
  if cms24 <> "" then check = " cms24"
  if cms31 <> "" then check = check || " cms31"
  if cmsfile <> "" then check = check || " cmsfile"
  if cmslibrary <> "" then check = check || " cmslibrary"
  if cms24file <> "" then check = check || " cms24file"
  if tso31 <> "" then check = check || " tso31"
  if tso64 <> "" then check = check || " tso64"
  if tso24 <> "" then check = check || " tso24"
  adapter = "pdos/tests/two-space/ipl_machine.py"
  if pcomm <> "" then do
    adapter = "pdos/tests/two-space/pcomm_machine.py"
    check = ""
  end
  call runlog "env PYTHONDONTWRITEBYTECODE=1 python3 " || adapter || " " || shellquote(disk) || " " || shellquote(core) || " " || shellquote(hercules) || " " || shellquote(runout) || check, out || "/ipl-machine.log"
  say "Fresh checked 3390 IPL and two-space successor machine gate pass."
  return 0

runlog: procedure = .int
  arg command = .string, log = .string
  address system "( " || command || " ) > " || shellquote(log) || " 2>&1"
  result = rc
  if result <> 0 then address crexx "run tail -n 40 :log"
  call require result = 0, "command; see " || log
  return 0

shellquote: procedure = .string
  arg value = .string
  return "'" || changestr("'", value, "'\''") || "'"

quoted: procedure = .string
  arg values = .string[]
  result = ""
  do i = 1 to values.0
    result = result || " " || shellquote(values[i])
  end
  return result

put_binary: procedure = .int
  arg path = .string, data = .binary
  file_id = 0; mode = "wb"
  assembler fopen file_id,path,mode
  call require file_id <> 0, "open " || path
  assembler fwriteb file_id,data
  write_status = 0; close_status = 0
  assembler ferror write_status,file_id
  assembler fclose close_status,file_id
  call require write_status = 0 & close_status = 0, "complete write " || path
  return 0

require: procedure = .int
  arg condition = .int, detail = .string
  if condition <> 1 then do
    say "FAILED:" detail
    exit 1
  end
  return 0

usage: procedure = .int
  say "usage: crexx -nokeep pdos/scripts/two-space-ipl.crexx --args NEW-build/pdos/output core-image GNU_AS GNU_LD HERCULES_BIN_DIR [PINNED_CMS24_STAGE [PINNED_CMS31_STAGE [PINNED_CMS31_IOQUAL_STAGE [PINNED_CMS31_LIBRARY_STAGE [PINNED_CMS24_IO24_STAGE [PINNED_TSO31_STAGE [PINNED_TSO64_ANY_STAGE [PINNED_TSO24_STAGE]]]]]]]]"
  return 2
