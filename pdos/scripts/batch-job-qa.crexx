/* SPDX-License-Identifier: MIT; frozen disposable Stage 2 qualification.
 * Maintenance lease and source/input freeze are operator prerequisites.
 * cut intentionally stops an active job; recover reuses its stopped disk.
 */
options levelb
import rxfnsb
main: procedure = .int
  arg args=.string[]
  if args.0<>5 then return 2
  media=args.1;herc=args.2;work=args.3;primary=args.4;mode=args.5
  if left(work,11)<>"build/pdos/" | pos("..",work)>0 then return 2
  if primary<>"3270" & primary<>"line" then return 2
  if mode<>"normal" & mode<>"cut" & mode<>"recover" & mode<>"dd" & mode<>"dd-data" then return 2
  address crexx "run test ! -e :work"
  if rc<>0 then return 2
  disk=media||"/media/pdos00.cckd";core=media||"-inputs/normal.core";hercules=herc||"/hercules"
  flags=.string[]
  if primary="line" then flags[flags.0+1]="--line-primary"
  else flags[flags.0+1]="--colour"
  commands="pdos/tests/batch/job-commands.json"
  if mode="cut" then do
    commands="pdos/tests/batch/job-cut.json";flags[flags.0+1]="--job-cut"
  end
  if mode="recover" then commands="pdos/tests/batch/job-recover.json"
  if mode="dd" | mode="dd-data" then do
    commands="pdos/tests/batch/dd-commands.json";flags[flags.0+1]="--batch-dd"
    if mode="dd-data" then do
      commands="pdos/tests/batch/dd-data-commands.json";flags[flags.0+1]="--batch-data"
    end
  end
  else flags[flags.0+1]="--batch-jobs"
  address crexx "run env PYTHONDONTWRITEBYTECODE=1 python3 pdos/tests/two-space/console_machine.py :disk :core :hercules :work --normal --monitor --workbench-normal --model 2 --commands :commands :flags[]"
  return rc
