/* SPDX-License-Identifier: MIT; focused extent/geometry slice, no guest. */
options levelb
import rxfnsb
main: procedure = .int
  arg args=.string[]
  i=.int;name=.string;names=.string;map=.string;linker=.string
  prior=.string;packer=.string;module=.string;stage=.string
  native=.string[];common=.string[]
  linker="build/tools/linker/mf-classic-ld"
  if args.0<1 | args.0>3 then return 2
  work=args.1
  if left(work,11)<>"build/pdos/" | pos("..",work)>0 then return 2
  address crexx "run test ! -e :work"
  if rc<>0 then return 2
  address crexx "run mkdir -p :work"
  if rc<>0 then return rc
  do i=1 to 4
    name=word("dasd dasd_geometry dasd_status diskmap_client",i);source="pdos/tests/two-space/"||name||".c";exe=work||"/"||name
    address crexx "run clang -std=c89 -Wall -Wextra -Werror -pedantic -fsanitize=address,undefined -I pdos/src pdos/src/twospace_dasd.c :source -o :exe"
    if rc<>0 then return rc
    address crexx "run :exe"
    if rc<>0 then return rc
  end
  cc="build/compiler/mvs/gcc/mf-classic-cc";classicas="build/tools/assembler/mf-classic-as"
  asm=work||"/TDA.asm";object=work||"/TDA.obj"
  address crexx "run :cc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -S -I pdos/src pdos/src/twospace_dasd.c -o :asm"
  if rc<>0 then return rc
  address crexx "run :classicas --profile s370 --capacity-profile desktop --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :asm :object"
  if rc<>0 then return rc
  asm=work||"/TWOSVC.asm";object=work||"/TWOSVC.obj"
  address crexx "run :cc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -DUSE_MEMMGR -S -I pdos/src -I pdpclib/src pdos/src/twospace_service.c -o :asm"
  if rc<>0 then return rc
  address crexx "run :classicas --profile s370 --capacity-profile desktop --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :asm :object"
  if rc<>0 then return rc
  asm=work||"/DISKMAP.asm";object=work||"/DISKMAP.obj"
  address crexx "run :cc -Os -DZARCH -U__CMS__ -D__MVS__ -D__PDOS390__ -DUSE_MEMMGR -S -I pdos/src -I pdpclib/src pdos/src/apps/diskmap.c -o :asm"
  if rc<>0 then return rc
  address crexx "run :classicas --profile s370 --capacity-profile desktop --macros -I pdpclib/src/profiles/pdos-zarch -I pdpclib/src -I pdpclib/src/interfaces/classic-linkage :asm :object"
  if rc<>0 then return rc
  if args.0>=2 then do
    prior=args.2
    if left(prior,1)<>"/" then return 2
    objects=.string[]
    names="TSMENTRY TWOSVC TSG TSD TSM TSR TSP TSV TSC TIO TSK TSH TSIF TSI TST TSS TTC T27 TDS TPH TWF TWD TWB TDA TTX TSCH TSTLB TSMKEY"
    do i=1 to words(names)
      name=word(names,i);base=prior
      if name="TWOSVC" | name="TDA" then base=work
      objects[i]=base||"/"||name||".obj"
    end
    binary=work||"/TWOSVC.bin";map=work||"/TWOSVC.map"
    address crexx "run :linker --oformat binary --image-base 33554432 -e TSMENTRY -Map :map -o :binary :objects[]"
    if rc<>0 then return rc
    say "Updated service and extent module link with the explicit unchanged kernel object inputs."
  end
  if args.0=3 then do
    image=args.3
    if left(image,1)<>"/" then return 2
    native[1]=image||"/command/part5.obj";native[2]=image||"/command/part1.obj"
    native[3]=image||"/command/part2.obj";native[4]=image||"/command/part6.obj"
    native[5]=image||"/base/support/MVSSUPA.obj";native[6]=image||"/command/stdlib.obj"
    names="START CTYPE STRING TIME ERRNO ASSERT LOCALE MATH SETJMP SIGNAL MEMMGR"
    do i=1 to words(names)
      native[i+6]=image||"/base/c/objects/"||word(names,i)||".obj"
    end
    names="ui console 3270 workbench surface history display recordio"
    do i=1 to words(names)
      common[i]=image||"/apps/"||word(names,i)||".obj"
    end
    object=work||"/DISKMAP.obj";module=work||"/diskmap.rdw";map=work||"/diskmap.map"
    address crexx "run :linker --oformat mvs --image-base 0 --amode 31 --rmode ANY -e @@CRT0 -Map :map -o :module :native[] :common[] :object"
    if rc<>0 then return rc
    packer=image||"/apps/pack-tso";stage=work||"/diskmap.bin"
    address crexx "run :packer :module :stage classic31"
    if rc<>0 then return rc
    say "Updated DISKMAP links and packs with the explicit unchanged U runtime objects."
  end
  inputs=.string[];hashes=.string[];outputs=.string[]
  address crexx "run rg --files --sort path pdos/src pdpclib/src" output inputs
  if rc<>0 then return rc
  names="VERSION CMakeLists.txt pdos/scripts/storage-check.crexx pdos/scripts/apps.crexx"
  do i=1 to words(names)
    inputs[inputs.0+1]=word(names,i)
  end
  names="dasd dasd_geometry dasd_status diskmap_client"
  do i=1 to words(names)
    name=word(names,i);inputs[inputs.0+1]="pdos/tests/two-space/"||name||".c"
    outputs[outputs.0+1]=work||"/"||name
  end
  inputs[inputs.0+1]=cc;inputs[inputs.0+1]=classicas;inputs[inputs.0+1]=linker
  names="TDA TWOSVC DISKMAP"
  do i=1 to words(names)
    outputs[outputs.0+1]=work||"/"||word(names,i)||".obj"
  end
  if args.0>=2 then do
    names="TSMENTRY TSG TSD TSM TSR TSP TSV TSC TIO TSK TSH TSIF TSI TST TSS TTC T27 TDS TPH TWF TWD TWB TTX TSCH TSTLB TSMKEY"
    do i=1 to words(names)
      inputs[inputs.0+1]=prior||"/"||word(names,i)||".obj"
    end
    outputs[outputs.0+1]=work||"/TWOSVC.bin"
  end
  if args.0=3 then do
    do i=1 to native.0
      inputs[inputs.0+1]=native[i]
    end
    do i=1 to common.0
      inputs[inputs.0+1]=common[i]
    end
    inputs[inputs.0+1]=packer;outputs[outputs.0+1]=module;outputs[outputs.0+1]=stage
  end
  address crexx "run shasum -a 256 :inputs[]" output hashes
  if rc<>0 then return rc
  do i=1 to hashes.0
    call lineout work||"/inputs.sha256",hashes[i]
  end
  call lineout work||"/inputs.sha256"
  call arraydrop hashes
  address crexx "run shasum -a 256 :outputs[]" output hashes
  if rc<>0 then return rc
  do i=1 to hashes.0
    call lineout work||"/outputs.sha256",hashes[i]
  end
  call lineout work||"/outputs.sha256"
  say "Geometry, K status and U DISKMAP controls/Classic C31 objects pass; larger guest media remain unqualified."
  return 0
