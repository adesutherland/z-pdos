/* SPDX-License-Identifier: MIT
 * Copyright (c) 2026 Adrian Sutherland
 * Development-host CLI contract checks. No Python or shell script is retained.
 * Arguments: assembler, standalone deck checker, fixture directory, owned
 * working directory. The named working directory belongs to this test; its
 * known output files are removed before each run. This is not a core host API.
 */
options levelb
import rxfnsb

main: procedure = .int
  arg args = .string[]
  if args.0 <> 4 then do
    say "usage: crexx -nokeep test_cli.crexx --args assembler checker fixtures owned-work-dir"
    return 2
  end
  cli = args.1; checker = args.2; fixtures = args.3; work = args.4
  call require work <> "" & work <> "/" & work <> ".", "owned work directory is required"
  command = "cmake -E make_directory " || shellquote(work)
  address shell command
  call require rc = 0, "create test working directory"
  stdout_path = work || "/stdout.txt"; stderr_path = work || "/stderr.txt"
  forms = fixtures || "/forms.asm"
  constants = fixtures || "/constants.asm"
  profile = fixtures || "/cli-profile.asm"

  call run_case cli, "--version", 0, stdout_path, stderr_path, "version"
  text = readfile(stdout_path)
  call require pos("mf-classic-as 0.1.0-bootstrap", text) > 0, "version identity"
  call require pos("bootstrap", text) > 0, "version capability"
  call require readfile(stderr_path) = "", "version stdout only"
  call run_case cli, "--help", 0, stdout_path, stderr_path, "help"
  call require pos("usage:", readfile(stdout_path)) > 0, "help text on stdout"
  call require readfile(stderr_path) = "", "help stdout only"
  call run_case cli, "", 2, stdout_path, stderr_path, "missing arguments"
  call run_case cli, "--profile", 2, stdout_path, stderr_path, "missing profile value"
  call run_case cli, "--profile z64", 2, stdout_path, stderr_path, "unsupported profile"
  call run_case cli, shellquote(forms), 2, stdout_path, stderr_path, "missing output"
  call run_case cli, "--literal-limit", 2, stdout_path, stderr_path, "missing literal capacity"
  call run_case cli, "--literal-limit -1", 2, stdout_path, stderr_path, "negative literal capacity"
  call run_case cli, "--literal-limit 65537", 2, stdout_path, stderr_path, "excessive literal capacity"
  call run_case cli, "--literal-limit 9999999999999999999999", 2, stdout_path, stderr_path, "overflowing literal capacity"
  limits_source = work || "/limits.asm"; limits_deck = work || "/limits.obj"
  call writefile limits_source, "S CSECT" || '0a'x || " USING S,12" || '0a'x || " L 1,=F'1'" || '0a'x || " L 2,=F'2'" || '0a'x || " END S" || '0a'x
  call erase limits_deck
  call run_case cli, "--literal-limit 1 " || shellquote(limits_source) || " " || shellquote(limits_deck), 1, stdout_path, stderr_path, "literal capacity enforced"
  call absent limits_deck
  call run_case cli, "--literal-limit 2 " || shellquote(limits_source) || " " || shellquote(limits_deck), 0, stdout_path, stderr_path, "explicit sufficient literal capacity"
  /* A two-definition/two-model consumer distinguishes both capacity knobs. */
  call run_case cli, "--help", 0, stdout_path, stderr_path, "capacity help"
  if pos("--macro-limit", readfile(stdout_path)) > 0 then do
    do i = 1 to 2
      option = word("--macro-limit --macro-model-limit",i)
      maximum_bad = word("1025 65537",i)
      call run_case cli, option, 2, stdout_path, stderr_path, "missing macro capacity"
      call run_case cli, option || " 0", 2, stdout_path, stderr_path, "zero macro capacity"
      call run_case cli, option || " -1", 2, stdout_path, stderr_path, "negative macro capacity"
      call run_case cli, option || " " || maximum_bad, 2, stdout_path, stderr_path, "excessive macro capacity"
      call run_case cli, option || " 9999999999999999999999", 2, stdout_path, stderr_path, "overflowing macro capacity"
      output = work || "/no-provider.obj"; call erase output
      call run_case cli, option || " 2 " || shellquote(forms) || " " || shellquote(output), 2, stdout_path, stderr_path, "capacity requires selected provider"
      call absent output
    end
    macros_source = work || "/macro-limits.asm"; macros_deck = work || "/macro-limits.obj"
    call writefile macros_source, changestr("|", " MACRO| ONE| LR 1,2| MEND| MACRO| TWO| LR 3,4| MEND|S CSECT| ONE| TWO| END S|", '0a'x)
    call erase macros_deck
    call run_case cli, "--macros --macro-limit 1 " || shellquote(macros_source) || " " || shellquote(macros_deck), 1, stdout_path, stderr_path, "macro definition capacity enforced"
    call absent macros_deck
    call run_case cli, "--macros --macro-model-limit 1 " || shellquote(macros_source) || " " || shellquote(macros_deck), 1, stdout_path, stderr_path, "macro model capacity enforced"
    call absent macros_deck
    call run_case cli, "--macros --macro-limit 2 --macro-model-limit 2 " || shellquote(macros_source) || " " || shellquote(macros_deck), 0, stdout_path, stderr_path, "sufficient explicit macro capacities"
  end
  output = work || "/extra.obj"; call erase output
  call run_case cli, shellquote(forms) || " " || shellquote(output) || " extra", 2, stdout_path, stderr_path, "extra argument"
  call absent output

  output = work || "/missing-input.obj"; call erase output
  missing = work || "/missing-input.asm"; call erase missing
  call run_case cli, shellquote(missing) || " " || shellquote(output), 2, stdout_path, stderr_path, "missing input"
  call absent output

  output = work || "/constants.obj"; call erase output
  call run_case cli, shellquote(constants) || " " || shellquote(output), 0, stdout_path, stderr_path, "constants"
  call run_case checker, "constants " || shellquote(output), 0, stdout_path, stderr_path, "constant object meaning"
  output = work || "/forms.obj"; call erase output
  call run_case cli, shellquote(forms) || " " || shellquote(output), 0, stdout_path, stderr_path, "instruction forms"
  call run_case checker, "forms " || shellquote(output), 0, stdout_path, stderr_path, "instruction object meaning"

  output = work || "/profile-s360.obj"; call erase output
  call run_case cli, shellquote(profile) || " " || shellquote(output), 1, stdout_path, stderr_path, "default S360 rejects S370 instruction"
  call absent output
  call require pos("status 3", readfile(stderr_path)) > 0, "unsupported instruction diagnostic"
  output = work || "/profile-s370.obj"; call erase output
  call run_case cli, "--profile s370 " || shellquote(profile) || " " || shellquote(output), 0, stdout_path, stderr_path, "selected S370"
  call run_case checker, "profile " || shellquote(output), 0, stdout_path, stderr_path, "S370 instruction meaning"

  call negative_case cli, fixtures, work, stdout_path, stderr_path, "range"
  call negative_case cli, fixtures, work, stdout_path, stderr_path, "undefined"
  call negative_case cli, fixtures, work, stdout_path, stderr_path, "unsupported"

  output = work || "/sentinel.obj"; call erase output
  sentinel = '6B65657000FF756E6368616E676564'x as .binary
  call qa_writebinary output, sentinel
  call run_case cli, shellquote(forms) || " " || shellquote(output), 2, stdout_path, stderr_path, "existing output refusal"
  call run_case checker, "sentinel " || shellquote(output), 0, stdout_path, stderr_path, "existing binary output preserved"
  input = work || "/same.asm"; call erase input
  original = readfile(forms); call writefile input, original
  call run_case cli, shellquote(input) || " " || shellquote(input), 2, stdout_path, stderr_path, "same input and output refusal"
  call require readfile(input) = original, "same-path source preserved"
  call run_case cli, shellquote(forms) || " " || shellquote(work), 2, stdout_path, stderr_path, "directory output refusal"

  input = work || "/crlf.asm"; output = work || "/crlf.obj"
  call erase input; call erase output
  call writefile input, changestr('0A'x, original, '0D0A'x)
  call run_case cli, shellquote(input) || " " || shellquote(output), 0, stdout_path, stderr_path, "CRLF input"
  call run_case checker, "forms " || shellquote(output), 0, stdout_path, stderr_path, "CRLF object meaning"
  input = work || "/eof.asm"; output = work || "/eof.obj"
  call erase input; call erase output
  call writefile input, left(original, length(original) - 1)
  call run_case cli, shellquote(input) || " " || shellquote(output), 0, stdout_path, stderr_path, "last card without newline"
  call run_case checker, "forms " || shellquote(output), 0, stdout_path, stderr_path, "last-card object meaning"
  say "CLI contracts passed: invocation, profiles, independent decks, failure preservation, CRLF and EOF"
  return 0

shellquote: procedure = .string
  arg value = .string
  return "'" || changestr("'", value, "'\''") || "'"

negative_case: procedure = .int
  arg cli = .string, fixtures = .string, work = .string, stdout_path = .string, stderr_path = .string, kind = .string
  output = work || "/" || kind || ".obj"; call erase output
  input = fixtures || "/cli-" || kind || ".asm"
  original = readfile(input)
  call run_case cli, shellquote(input) || " " || shellquote(output), 1, stdout_path, stderr_path, "failed " || kind
  call absent output
  call require readfile(input) = original, "failed assembly preserves source " || kind
  call require pos("status", readfile(stderr_path)) > 0, "source diagnostic " || kind
  return 0

require: procedure = .int
  arg condition = .int, description = .string
  if condition <> 1 then do
    say "FAILED: " || description
    exit 1
  end
  return 0

run_case: procedure = .int
  arg executable = .string, arguments = .string, expected = .int, stdout_path = .string, stderr_path = .string, description = .string
  command = shellquote(executable) || " " || arguments || " > " || shellquote(stdout_path) || " 2> " || shellquote(stderr_path)
  address shell command
  actual = rc
  if actual <> expected then do
    say "FAILED: " || description || " returned " || actual || " expected " || expected
    say readfile(stderr_path)
    exit 1
  end
  return 0

erase: procedure = .int
  arg path = .string
  command = "cmake -E rm -f " || shellquote(path)
  address shell command
  call require rc = 0, "remove test-owned output " || path
  return 0

absent: procedure = .int
  arg path = .string
  file_id = 0; mode = "rb"
  assembler fopen file_id,path,mode
  if file_id <> 0 then do
    close_status = 0
    assembler fclose close_status,file_id
    say "FAILED: failed command published " || path
    exit 1
  end
  return 0

readfile: procedure = .string
  arg path = .string
  file_id = 0; mode = "rb"
  assembler fopen file_id,path,mode
  call require file_id <> 0, "read test file " || path
  data = .binary; amount = 65536
  assembler freadb data,file_id,amount
  close_status = 0; read_status = 0
  assembler ferror read_status,file_id
  assembler fclose close_status,file_id
  call require read_status = 0 & close_status = 0, "complete test file read " || path
  return data as .string

writefile: procedure = .int
  arg path = .string, text = .string
  data = text as .binary
  return qa_writebinary(path, data)

qa_writebinary: procedure = .int
  arg path = .string, data = .binary
  file_id = 0; mode = "wb"
  assembler fopen file_id,path,mode
  call require file_id <> 0, "write test file " || path
  assembler fwriteb file_id,data
  write_status = 0; close_status = 0
  assembler ferror write_status,file_id
  assembler fclose close_status,file_id
  call require write_status = 0 & close_status = 0, "complete test file write " || path
  return 0
