options levelb
import rxfnsb

main: procedure = .int
  arg args = .string[]
  if args.0 <> 1 then return 2
  prefix = args.1
  call require left(prefix, 6) = "build/" & length(prefix) > 6 & pos("..", prefix) = 0, "owned test prefix"
  names = "mvs38-s370-24 tso31-lean tso31-sdk-files tso-zos15-24 pdos390-esa pdos-zarch"
  natives = "8cfcd65f10cb26d082ac2dd2ab1492fd8c295217c038a982b9040189003b7496 b55a108de8fafd33a521df3a2e1f3d991182bc38800cb118e1d4baf32f0bc3a7 458c3f8f3ce426bc470c160eb160dfa40b5092153651ed239610c45dfa31a67c 78e32172e527a6e04bc77e98c803d48e34812831cc48f89c920d3fbe710aa041 8cfcd65f10cb26d082ac2dd2ab1492fd8c295217c038a982b9040189003b7496 8cfcd65f10cb26d082ac2dd2ab1492fd8c295217c038a982b9040189003b7496"
  members = "df47ea952e18fdeb0610a4cdeb1184f24679cb6c4a6d0187153640671064ab34 17b4e7b0c9fe7a4ac377549f086934e4bba7a75b5f19d78b54117f1a51245ffb 17b4e7b0c9fe7a4ac377549f086934e4bba7a75b5f19d78b54117f1a51245ffb 17b4e7b0c9fe7a4ac377549f086934e4bba7a75b5f19d78b54117f1a51245ffb f7971238a30ca1c3748bcb6ec797dc567e2ca925dd64116f9f3fce2050e77431 667f7f099e58f14ceb5c274e98a83ee2e1ef0dd9d856ca2281b5f675ac28786e"
  do i = 1 to words(names)
    profile = word(names, i); work = prefix || "-" || profile
    address shell "cmake -E rm -rf " || shellquote(work)
    call require rc = 0, "clear owned fixture"
    address crexx "run crexx -nokeep pdpclib/scripts/prepare.crexx --args :profile :work"
    call require rc = 0, "prepare explicit profile"
    record = readfile(work || "/profile-source.sha256")
    call require word(record, 1) = word(natives, i), "exact native source variant"
    call require word(record, 3) = word(members, i), "exact configuration member"
    call require word(record, 5) = "b6bf7412c483aa5eaa72975327e33af06cbf01e0bb5f8486cce64df32f7333d6", "consolidated string source"
    call require word(record, 7) = "e385cd5cdf3bf9b3c911da20fcf8da1e046eaa48680b56745371fa8c643ab21a", "consolidated stdio source"
    address crexx "run crexx -nokeep pdpclib/scripts/prepare.crexx --args :profile :work"
    call require rc <> 0, "existing output rejected"
    call require readfile(work || "/profile-source.sha256") = record, "existing output unchanged"
  end
  address crexx "run crexx -nokeep pdpclib/scripts/prepare.crexx --args unknown :prefix"
  call require rc <> 0, "unknown profile rejected"
  address crexx "run crexx -nokeep pdpclib/scripts/prepare.crexx --args mvs38-s370-24 ."
  call require rc <> 0, "unowned output rejected"
  say "Six explicit profile source identities pass; no target assembly or guest claim."
  return 0

shellquote: procedure = .string
  arg value = .string
  return "'" || changestr("'", value, "'\''") || "'"

require: procedure = .int
  arg condition = .int, detail = .string
  if condition <> 1 then do
    say "FAILED: " || detail
    exit 1
  end
  return 0

readfile: procedure = .string
  arg path = .string
  file_id = 0; mode = "rb"
  assembler fopen file_id,path,mode
  call require file_id <> 0, "open profile receipt"
  result = ""; eof = 0; read_status = 0
  do forever
    data = ""
    assembler freadline data,file_id
    assembler ferror read_status,file_id
    call require read_status = 0, "read profile receipt"
    assembler feof eof,file_id
    if length(data) = 0 & eof <> 0 then leave
    result = result || data || '0A'x
    call require length(result) <= 4096, "bounded profile receipt"
  end
  close_status = 0
  assembler fclose close_status,file_id
  call require close_status = 0, "close profile receipt"
  return result
