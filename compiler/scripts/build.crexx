 * Native host build of the inherited compiler only. Run from repository root.
 */
options levelb
import rxfnsb
main: procedure = .int
  arg args = .string[]
  if args.0 < 1 | args.0 > 2 then return usage()
  action = args.1
  variant = "mvs"
  if args.0 = 2 then variant = args.2
  if action <> "build" & action <> "test" then return usage()
  if variant <> "mvs" & variant <> "cms" then return usage()
  location = .string[]
  address crexx "pwd" output location
  root = strip(location.1)
  address crexx "run test -f compiler/src/gcc/config/i370/i370.c"
  if rc <> 0 then return 2
  work = root || "/build/compiler/" || variant
  source = root || "/compiler/src/configure"
  target = "i370-ibm-mvspdp"
  if variant = "cms" then target = "i370-ibm-cms"
  flags = "-g -O0 -fcommon -std=gnu89 -w -Wno-implicit-int -Wno-implicit-function-declaration -Wno-int-conversion -Wno-error -Wno-return-type -Wno-deprecated-non-prototype"
  environment = "env " || shellquote("CC=cc") || " " || shellquote("CFLAGS=" || flags) || " " || shellquote("LDFLAGS=")
  address crexx "mkdir -p :work"
  if rc <> 0 then return rc
  address crexx "cd :work"
  if rc <> 0 then return rc
  configure = environment || " /bin/sh " || shellquote(source) || " --target=" || target || " --enable-languages=c --disable-threads --disable-nls --disable-shared --without-headers " || shellquote("--prefix=" || work || "/install") || " " || shellquote("--with-gcc-version-trigger=" || root || "/compiler/src/gcc/version.c")
  say "Configuring" variant "; log:" work || "/configure.log"
  address system configure || " > configure.log 2>&1"
  if rc <> 0 then return rc
  say "Building compiler; log:" work || "/build.log"
  address system environment || " make -j6 all-gcc U= " || shellquote("CFLAGS=" || flags) || " " || shellquote("CFLAGS_FOR_BUILD=" || flags) || " > build.log 2>&1"
  if rc <> 0 then return rc
  gccdir = work || "/gcc"
  launcher = root || "/compiler/src/driver.c"
  command = gccdir || "/mf-classic-cc"
  define = '-DMF_CC_DIR="' || gccdir || '"'
  address crexx "run cc -std=c89 -Wall -Wextra -pedantic :define :launcher -o :command"
  if rc <> 0 then return rc
  address crexx "cd :root"
  if rc <> 0 then return rc
  address crexx "run :command --version"
  if rc <> 0 then return rc
  if action = "build" then return 0
  cc1env = "CC1=" || gccdir || "/cc1"
  address system "env " || shellquote(cc1env) || " sh compiler/src/tests/run.sh > " || shellquote(work || "/codegen-tests.log") || " 2>&1"
  if rc <> 0 then do
    say "Code-generation tests failed; see" work || "/codegen-tests.log"
    return rc
  end
  address crexx "run crexx -nokeep compiler/scripts/test.crexx --args :variant"
  return rc

shellquote: procedure = .string
  arg value = .string
  return "'" || changestr("'", value, "'\''") || "'"

usage: procedure = .int
  say "usage: crexx -nokeep compiler/scripts/build.crexx --args build|test [mvs|cms]"
  return 2
